#include "Calib.c"
#include "flash_fake.h"
#include <assert.h>
#include <math.h>
#include <stdio.h>

static unsigned checks;
#define CHECK(x) do { checks++; assert(x); } while (0)
static const CalibParams_t first = {1.01f, 0.99f, 1.02f, 1.1f, -1.5f};
static const CalibParams_t second = {0.98f, 1.03f, 0.96f, 0.9f, 2.0f};
static const CalibParams_t defaults = CALIB_DEFAULT_PARAMS;

static void Expect(const CalibParams_t *params, uint8_t stored)
{
    CHECK(Calib_Init() == stored);
    CHECK(memcmp(Calib_Get(), params, sizeof(*params)) == 0);
}
static void UpdateCrc(CalibRecord_t *record)
{
    record->crc = RecordCrc(record, offsetof(CalibRecord_t, crc));
}
int main(void)
{
    CHECK(CALIB_PAGE_COUNT == 1U && sizeof(fake_flash) == 1024U);
    CHECK(RecordCrc("123456789", 9) == 0xcbf43926U);
    FakeFlash_Reset();
    Expect(&defaults, 0);
    CHECK(Calib_Save(NULL) == CALIB_INVALID);
    const float invalid[] = {NAN, INFINITY, -INFINITY, 0.0f, -1.0f,
                             0.249f, 4.001f};
    for (unsigned field = 0; field < 5; field++)
    {
        for (unsigned i = 0; i < sizeof(invalid)/sizeof(invalid[0]); i++)
        {
            float fields[5]; memcpy(fields, &defaults, sizeof(fields));
            float value = invalid[i];
            if (field == 4 && isfinite(value)) value = i % 2 ? -20.01f : 20.01f;
            fields[field] = value;
            CalibParams_t params; memcpy(&params, fields, sizeof(params));
            CHECK(Calib_Save(&params) == CALIB_INVALID);
        }
    }
    CHECK(fake_erases == 0 && fake_service == 0);
    CalibParams_t boundary = {0.25f, 4.0f, 0.25f, 4.0f, -20.0f};
    CHECK(Calib_Validate(&boundary));
    boundary.temperature_offset_c = 20.0f;
    CHECK(Calib_Validate(&boundary));
    fake_busy = 1;
    CHECK(Calib_Save(&first) == CALIB_BUSY && !fake_service);
    fake_busy = 0;
    CHECK(Calib_Save(&first) == CALIB_OK);
    CHECK(memcmp(Calib_Get(), &defaults, sizeof(defaults)) == 0);
    CHECK(fake_erases == 1 && fake_programs == 39);
    Expect(&first, 1);
    fake_service = 0;
    CHECK(Calib_Save(&first) == CALIB_UNCHANGED);
    CHECK(fake_erases == 1 && !fake_service);
    CHECK(Calib_Save(&second) == CALIB_OK);
    Expect(&second, 1);

    /* There is no second page: corrupt data/CRC/commit selects defaults. */
    uint32_t snapshot[CALIB_PAGE_COUNT][CALIB_PAGE_SIZE / sizeof(uint32_t)];
    memcpy(snapshot, fake_flash, sizeof(snapshot));
    for (unsigned bit = 0; bit < 78 * 8; bit++)
    {
        memcpy(fake_flash, snapshot, sizeof(snapshot));
        ((uint8_t *)fake_flash[0])[bit / 8] ^= (uint8_t)(1U << (bit % 8));
        Expect(&defaults, 0);
    }
    memcpy(fake_flash, snapshot, sizeof(snapshot));
    CalibRecord_t *record = (CalibRecord_t *)fake_flash[0];
    record->version++; UpdateCrc(record); Expect(&defaults, 0);
    memcpy(fake_flash, snapshot, sizeof(snapshot));
    record->size--; UpdateCrc(record); Expect(&defaults, 0);
    memcpy(fake_flash, snapshot, sizeof(snapshot));
    record->params.vin_gain = NAN; UpdateCrc(record); Expect(&defaults, 0);

    /* Before erase the old record survives. After erase, an incomplete
     * update uses defaults; only the final commit makes the new record valid. */
    FakeFlash_Reset();
    CHECK(Calib_Save(&first) == CALIB_OK);
    memcpy(snapshot, fake_flash, sizeof(snapshot));
    fake_busy = 1;
    CHECK(Calib_Save(&second) == CALIB_BUSY);
    Expect(&first, 1);
    fake_busy = 0;
    for (int cut = 0; cut <= 40; cut++)
    {
        memcpy(fake_flash, snapshot, sizeof(snapshot));
        fake_fail_after = cut;
        CHECK(Calib_Save(&second) == CALIB_FLASH_ERROR);
        Expect(cut == 0 ? &first : (cut == 40 ? &second : &defaults),
               cut == 0 || cut == 40);
    }
    for (int cut = 0; cut <= 40; cut++)
    {
        FakeFlash_Reset(); fake_fail_after = cut;
        CHECK(Calib_Save(&first) == CALIB_FLASH_ERROR);
        Expect(cut == 40 ? &first : &defaults, cut == 40);
    }
    FakeFlash_Reset();
    CHECK(Calib_Save(&first) == CALIB_OK);
    fake_corrupt_body = 1;
    CHECK(Calib_Save(&second) == CALIB_FLASH_ERROR);
    Expect(&defaults, 0);

    /* Keep the existing record format; sequence still wraps on rewrite. */
    FakeFlash_Reset(); CHECK(Calib_Save(&first) == CALIB_OK);
    record = (CalibRecord_t *)fake_flash[0];
    record->sequence = UINT32_MAX; UpdateCrc(record);
    CHECK(Calib_Save(&second) == CALIB_OK);
    Expect(&second, 1);
    CHECK(((CalibRecord_t *)fake_flash[0])->sequence == 0);
    CHECK(Calib_Save(&first) == CALIB_OK);
    Expect(&first, 1);
    ((uint8_t *)fake_flash[0])[0] ^= 1;
    Expect(&defaults, 0);
    /* Defaults, validation, independent saves and backwards compatibility. */
    const ProtectionParams_t protection_defaults = PROTECTION_DEFAULT_PARAMS;
    FakeFlash_Reset(); Calib_Init();
    CHECK(memcmp(Calib_GetProtection(), &protection_defaults, 40) == 0);
    ProtectionParams_t p = protection_defaults, stored;
    CHECK(Calib_ReadStoredProtection(&stored) == CALIB_INVALID);
    CHECK(!Calib_ValidateProtection(NULL));
    const float bad[] = {NAN, INFINITY, -INFINITY};
    for (unsigned field = 0; field < 9; field++)
        for (unsigned i = 0; i < 3; i++)
        {
            p = protection_defaults;
            memcpy((uint8_t *)&p + field * 4, &bad[i], 4);
            CHECK(Calib_SaveProtection(&p) == CALIB_INVALID);
        }
    p = protection_defaults; p.uv_in_recover_v = p.uv_in_v;
    CHECK(Calib_SaveProtection(&p) == CALIB_INVALID);
    p = protection_defaults; p.ov_recover_v = p.ov_v;
    CHECK(Calib_SaveProtection(&p) == CALIB_INVALID);
    p = protection_defaults; p.ot_recover_c = p.ot_c;
    CHECK(Calib_SaveProtection(&p) == CALIB_INVALID);
    p = protection_defaults; p.recover_hold_ms = 0;
    CHECK(Calib_SaveProtection(&p) == CALIB_INVALID);
    p.recover_hold_ms = 65536;
    CHECK(Calib_SaveProtection(&p) == CALIB_INVALID);
    CHECK(fake_erases == 0 && !fake_service);
    p = protection_defaults; p.oc_a = 2.0f; p.recover_hold_ms = 1234;
    CHECK(Calib_SaveProtection(&p) == CALIB_OK);
    CHECK(memcmp(Calib_GetProtection(), &protection_defaults, 40) == 0);
    CHECK(Calib_Save(&first) == CALIB_OK); /* preserve pending Protection */
    CHECK(Calib_ReadStoredProtection(&stored) == CALIB_OK);
    CHECK(memcmp(&stored, &p, 40) == 0);
    Expect(&first, 1);
    CHECK(memcmp(Calib_GetProtection(), &p, 40) == 0);
    unsigned erases = fake_erases;
    CHECK(Calib_SaveProtection(&p) == CALIB_UNCHANGED && fake_erases == erases);
    CHECK(Calib_RestoreDefaults() == CALIB_OK);
    CHECK(Calib_ReadStoredProtection(&stored) == CALIB_OK);
    CHECK(memcmp(&stored, &p, 40) == 0);
    CHECK(Calib_Save(&second) == CALIB_OK);
    CHECK(Calib_RestoreProtectionDefaults() == CALIB_OK);
    Expect(&second, 1);
    CHECK(memcmp(Calib_GetProtection(), &protection_defaults, 40) == 0);

    /* Original v1 record loads its Calib without rewriting or losing it. */
    FakeFlash_Reset();
    CalibLegacyRecord_t legacy = {.magic=CALIB_MAGIC, .version=1,
        .size=40, .sequence=42, .params=first, .commit=CALIB_COMMIT};
    legacy.crc = RecordCrc(&legacy, offsetof(CalibLegacyRecord_t, crc));
    memcpy(fake_flash, &legacy, sizeof(legacy));
    Expect(&first, 1);
    CHECK(memcmp(Calib_GetProtection(), &protection_defaults, 40) == 0);
    CHECK(Calib_ReadStoredProtection(&stored) == CALIB_INVALID);
    CHECK(Calib_Save(&first) == CALIB_UNCHANGED && fake_erases == 0);
    CHECK(Calib_SaveProtection(&p) == CALIB_OK);
    Expect(&first, 1);
    CHECK(memcmp(Calib_GetProtection(), &p, 40) == 0);
    CHECK(((CalibRecord_t *)fake_flash)->sequence == 43);
    memcpy(fake_flash, &legacy, sizeof(legacy));
    ((uint8_t *)fake_flash)[12] ^= 1;
    Expect(&defaults, 0);
    CHECK(memcmp(Calib_GetProtection(), &protection_defaults, 40) == 0);
    printf("Calib + Protection storage: %u checks passed\n", checks);
    return 0;
}
