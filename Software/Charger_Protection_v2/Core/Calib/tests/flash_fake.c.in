#include "flash_fake.h"
#include <string.h>
#include <assert.h>

uint32_t fake_flash[CALIB_PAGE_COUNT][CALIB_PAGE_SIZE / sizeof(uint32_t)];
int fake_fail_after = -1, fake_busy, fake_corrupt_body;
unsigned fake_erases, fake_programs, fake_service;

void FakeFlash_Reset(void)
{
    memset(fake_flash, 0xff, sizeof(fake_flash));
    fake_fail_after = -1;
    fake_busy = fake_corrupt_body = 0;
    fake_erases = fake_programs = fake_service = 0;
}
const void *CalibFlash_Page(uint32_t page)
{
    assert(page < CALIB_PAGE_COUNT);
    return fake_flash[page];
}
static int Step(void)
{
    if (fake_fail_after == 0) return 0;
    if (fake_fail_after > 0) fake_fail_after--;
    return 1;
}
CalibStatus_t CalibFlash_Replace(uint32_t page, const void *body,
                                           uint32_t length, uint16_t commit)
{
    assert(page < CALIB_PAGE_COUNT && length == 76);
    if (fake_busy) return CALIB_BUSY;
    fake_service = 1;
    if (!Step()) return CALIB_FLASH_ERROR;
    memset(fake_flash[page], 0xff, CALIB_PAGE_SIZE);
    fake_erases++;
    const uint8_t *source = body;
    uint8_t *target = (uint8_t *)fake_flash[page];
    for (unsigned offset = 0; offset < length; offset += 2)
    {
        if (!Step()) return CALIB_FLASH_ERROR;
        target[offset] &= source[offset];
        target[offset + 1] &= source[offset + 1];
        fake_programs++;
    }
    if (fake_corrupt_body) target[12] ^= 1;
    if (memcmp(target, source, length) != 0) return CALIB_FLASH_ERROR;
    if (!Step()) return CALIB_FLASH_ERROR;
    target[length] &= (uint8_t)commit;
    target[length + 1] &= (uint8_t)(commit >> 8);
    fake_programs++;
    /* A reset immediately after commit can occur before the ACK/return. */
    return fake_fail_after == 0 ? CALIB_FLASH_ERROR : CALIB_OK;
}
