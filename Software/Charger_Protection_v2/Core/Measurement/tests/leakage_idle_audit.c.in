/* Diagnostic reproduction, not a model of the physical board's noise source.
 * Reuses the actual ADC/DMA, Measurement, Protection, Calib and scheduler. */
#define main measurement_regression_main
#define RTE_INTEGRATION_TEST
#include "measurement_host_test.c"
#undef main
#include "Protection.c"
#include "scheduler.c"

unsigned mock_pins[4], mock_primask, mock_systick_enabled;
unsigned mock_trip_on_unmask;
void mock_restore_primask(uint32_t value) { mock_primask = value; }

static void audit_irq(void)
{
    Measurement_DMA_IRQHandler();
    Protection_FastLeakageISR();
}

static void audit_tick(void) { Scheduler_Tick1msISR(); }

static void audit_boot(void)
{
    FakeFlash_Reset();
    reset_measurement();
    mock_primask = 0;
    ProtectionInit();
    Scheduler_Init();
    mock_dma_dispatch_hook = audit_irq;
    mock_post_dma_hook = audit_tick;
    mock_post_main_hook = Scheduler_MainFunction;
}

static void audit_case(const char *name, unsigned scenario)
{
    audit_boot();
    float max_rms = 0;
    uint16_t scans[50];
    for (unsigned block = 0; block < 800; block++)
    {
        for (unsigned j = 0; j < 10; j++)
        {
            unsigned n = block * 10 + j;
            for (unsigned ch = 0; ch < 5; ch++) scans[j * 5 + ch] = 2048;
            int32_t leak = 2036; /* 1.6403 V: reported idle DC bias. */
            if (scenario == 1) leak += (n & 1) ? 3 : -3;
            if (scenario == 2) leak += (n % 20 == 0) ? 8 :
                                       (n % 20 == 1) ? -8 : ((n & 1) ? 5 : -5);
            if (scenario == 3 && n == 2500) leak += 8;
            if (scenario == 4 && n < 500) leak -= 48 - (int32_t)n * 48 / 500;
            if (scenario == 5 && n >= 2100) leak += 12;
            scans[j * 5 + ADC_CH_ILEAK] = (uint16_t)leak;
        }
        process_half(scans, 1);
        if (MeasureResult.I_leak_rms > max_rms) max_rms = MeasureResult.I_leak_rms;
    }
    printf("%s: Vin=%.3f V, latest=%.3f mA, max-window=%.3f mA, "
           "ADC_RMS=%.3f, bias=%.4f V, fast=%u, faults=0x%02lx\n",
           name, MeasureResult.V_in_rms, MeasureResult.I_leak_rms * 1000,
           max_rms * 1000, MeasureResult.leakage_adc_rms,
           MeasureResult.I_leak_DC_Offset, MeasureResult.leakage_trip_flag,
           (unsigned long)Protection_GetFaultMask());
}

int main(void)
{
    printf("Default conversion: %.6f mA/count; RMS trip %.3f mA; "
           "peak trip %ld counts (%.3f mA)\n", LEAK_A_PER_COUNT * 1000,
           PROTECTION_LEAK_A * 1000, (long)LEAK_TRIP_COUNTS,
           LEAK_TRIP_COUNTS * LEAK_A_PER_COUNT * 1000);
    audit_case("DC only, no AC", 0);
    audit_case("No AC, +/-3-count noise", 1);
    audit_case("No AC, 5.38-count RMS noise, 8-count peaks", 2);
    audit_case("No AC, one 8-count sample after startup", 3);
    audit_case("No AC, bias settles 48 counts in first 50 ms", 4);
    audit_case("No AC, DC bias steps 12 counts after 210 ms", 5);
    return 0;
}
