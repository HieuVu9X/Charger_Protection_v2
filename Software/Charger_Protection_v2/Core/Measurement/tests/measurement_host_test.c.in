/* Host tests compile the ACTUAL production Measurement.c. Hardware is stubbed.
 * .c.in prevents CubeIDE from treating this file as firmware source. */
#include <stdio.h>
#include <math.h>
#include <stdlib.h>
#include <stdint.h>
#include <stddef.h>
#include <string.h>
#include "Measurement.c"
#include "Protection.h"
#include "flash_fake.h"
/* Qualifier plus LPF settling, rounded to complete 10-scan DMA segments. */
#define FAST_TEST_BLOCKS ((MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES + 13U) / 10U)

int RteTest_IsAdcClipped(AdcClippedMask_t mask);
float RteTest_LeakageAdcRms(void);
float RteTest_TemperatureAdcAverage(void);
static unsigned failures, checks, mock_errors, next_half;
unsigned mock_ht, mock_tc, mock_te, mock_timer_running, mock_dma_running;
static unsigned mock_cross_count;
static uint32_t mock_cross_indices[256];
static void (*mock_post_dma_hook)(void);
static void (*mock_dma_dispatch_hook)(void);
static void (*mock_post_main_hook)(void);
static double channel_bias[AC_CHANNELS];
void Error_Handler(void) { mock_errors++; }
#ifndef RTE_INTEGRATION_TEST
/* Peer mocks terminate the REAL RTE wrappers in this component unit test. */
void ProtectionInit(void) {}
void Protection_MainFunction(void) {}
void Protection_FastLeakageISR(void) {}
void Protection_Tick1msISR(void) {}
void Protection_EmergencyStop(void) {}
void Protection_ZeroCrossISR(void)
{
    if (mock_cross_count < 256U) mock_cross_indices[mock_cross_count] = sample_index;
    mock_cross_count++;
}
#endif

static void check(int condition, const char *name)
{
    checks++;
    if (!condition) { fprintf(stderr, "FAIL: %s\n", name); failures++; }
}
static void close_to(float actual, float expected, float tolerance, const char *name)
{
    checks++;
    if (!isfinite(actual) || fabsf(actual-expected)>tolerance)
    {
        fprintf(stderr,"FAIL: %s: actual=%.6f expected=%.6f tolerance=%.6f\n",name,actual,expected,tolerance);
        failures++;
    }
}
static void reset_measurement(void)
{
    Calib_Init();
    memset(&MeasureResult,0,sizeof(MeasureResult));
    memset(&accumulator,0,sizeof(accumulator));
    Window_t empty; memset(&empty,0,sizeof(empty)); pending_window=empty;
    memset(&vin_filter,0,sizeof(vin_filter));
    memset(&vout_filter,0,sizeof(vout_filter));
    memset(&iin_filter,0,sizeof(iin_filter));
    sample_count=0; data_ready_flag=0; adc_bias_ready=0;
    for(unsigned ch=0;ch<4;ch++) adc_offset[ch]=2048;
    sample_index=last_cross_index=candidate_index=last_valid_index=0;
    last_cross_fraction=candidate_fraction=frequency_raw=0;
    previous_vin_ac=0; frequency_armed=candidate_ready=previous_cross_ready=0;
    previous_iin=0; iin_initialized=0;
    zero_cross_polarity=0; zero_cross_valid_edges=0; zero_cross_last_index=0;
    mock_cross_count=0;
    mock_dma_dispatch_hook=mock_post_dma_hook=mock_post_main_hook=NULL;
    mock_ht=mock_tc=mock_te=mock_errors=next_half=0;
    memset(channel_bias,0,sizeof(channel_bias));
    MeasurementInit();
}
static uint16_t adc_code(double voltage)
{
    long value=lround(voltage*4096.0/3.3);
    if(value<0) value=0;
    if(value>4095) value=4095;
    return (uint16_t)value;
}
static uint16_t ntc_code(double temperature)
{
    /* Independent TDK NTCG163JF103HT1 nominal B25/85 model. */
    double r=10000.0*exp(3435.0*(1.0/(temperature+273.15)-1.0/298.15));
    return adc_code(3.3*r/(10000.0+r));
}
static void process_half(const uint16_t *buffer, int run_main)
{
    memcpy(&adc_dma_buffer[next_half*50],buffer,50*sizeof(uint16_t));
    if(next_half==0) mock_ht=1; else mock_tc=1;
    if(mock_dma_dispatch_hook) mock_dma_dispatch_hook();
    else Measurement_DMA_IRQHandler();
    next_half^=1;
    if(mock_post_dma_hook) mock_post_dma_hook();
    if(run_main)
    {
        if(mock_post_main_hook) mock_post_main_hook();
        else Measurement_MainFunction();
    }
}

/* Independent analog model: resistor-divider RC response in continuous time,
 * unity-gain shunt amplifier, and floating ideal CT loaded by 4700 || 200 ohm.
 * Source harmonic voltages/currents are RMS and may have independent phases. */
static void feed(unsigned samples, double freq, double vrms, double irms,
                 double phase, double leak_rms, double temperature,
                 double v3, double i3, double phase3, double bias, int run_main)
{
    const double pi=3.14159265358979323846;
    const double divider=(9400000.0+33000.0)/33000.0;
    const double tau=9400000.0*33000.0/(9400000.0+33000.0)*100e-9;
    const double shunt=0.05/3.0;
    const double rleak=4700.0*200.0/(4700.0+200.0);
    const double skew=2.0*54.0/14000000.0;
    uint16_t buffer[50];
    for(unsigned block=0;block<samples/10;block++)
    {
        for(unsigned j=0;j<10;j++)
        {
            double t=(double)(sample_index+j)/10000.0;
            double angle=2*pi*freq*t;
            double x=2*pi*freq*tau;
            double voltage=sqrt(2.0)*vrms/divider/hypot(1.0,x)*sin(angle-atan(x));
            voltage+=sqrt(2.0)*v3/divider/hypot(1.0,3*x)*sin(3*angle-atan(3*x));
            double current=sqrt(2.0)*irms*sin(angle+2*pi*freq*skew-phase);
            current+=sqrt(2.0)*i3*sin(3*angle+6*pi*freq*skew-phase3);
            buffer[j*5+0]=adc_code(1.65*9400000.0/(9400000.0+33000.0)+voltage+bias+channel_bias[0]);
            buffer[j*5+1]=adc_code(1.65*9400000.0/(9400000.0+33000.0)+0.8*voltage+bias+channel_bias[1]);
            buffer[j*5+2]=adc_code(1.65+0.004+current*shunt+bias+channel_bias[2]);
            buffer[j*5+3]=adc_code(1.65+0.003+sqrt(2.0)*leak_rms*rleak/1000.0*sin(angle)+bias+channel_bias[3]);
            buffer[j*5+4]=ntc_code(temperature);
        }
        process_half(buffer,run_main);
    }
}

static void test_actual_dc_bias(void)
{
    /* Each channel has its own measured DC level, not a common 1.65 V. */
    static const uint16_t biases[][AC_CHANNELS] = {
        {2036,2036,2036,2036}, /* Reported board: about 1.64 V. */
        {1975,2137,2002,1900},
        {1200,1500,2500,2800},
    };
    uint16_t scans[50];
    FakeFlash_Reset();
    for(unsigned which=0;which<sizeof(biases)/sizeof(biases[0]);which++)
    {
        reset_measurement();
        for(unsigned j=0;j<10;j++)
        {
            for(unsigned ch=0;ch<AC_CHANNELS;ch++) scans[j*5+ch]=biases[which][ch];
            scans[j*5+ADC_CH_TEMP]=2048;
        }
        for(unsigned block=0;block<199;block++) process_half(scans,1);
        check(!MeasureResult.startup_complete && !MeasureResult.leakage_trip_flag,
              "non-midscale DC cannot arm leakage during first bias window");
        process_half(scans,1);
        for(unsigned ch=0;ch<AC_CHANNELS;ch++)
            check(adc_offset[ch]==biases[which][ch],"learn independent ADC channel bias after 200 ms");
        for(unsigned block=0;block<600;block++) process_half(scans,1);
        close_to(MeasureResult.V_in_rms,0,0.0001f,"constant off-midscale Vin has zero AC RMS");
        close_to(MeasureResult.V_out_rms,0,0.0001f,"constant off-midscale Vout has zero AC RMS");
        close_to(MeasureResult.I_in_rms,0,0.0001f,"constant off-midscale current has zero AC RMS");
        close_to(MeasureResult.I_leak_rms,0,0.000001f,"constant off-midscale leakage has zero AC RMS");
        close_to(MeasureResult.P_in_active,0,0.0001f,"independent DC biases produce no real power");
        check(!MeasureResult.leakage_trip_flag && !mock_cross_count,
              "learned DC bias creates neither leakage trip nor relay crossings");
        close_to(MeasureResult.I_leak_DC_Offset,biases[which][3]*3.3f/4096,0.000001f,
                 "diagnostic offset reports the measured bias voltage");
    }

    /* RMS and fast paths retain their own fractional measured biases.
     * Two adjacent codes have 0.5-count RMS. */
    reset_measurement();
    for(unsigned j=0;j<10;j++)
    {
        for(unsigned ch=0;ch<5;ch++) scans[j*5+ch]=2048;
        scans[j*5+ADC_CH_ILEAK]=(j&1)?2036:2035;
    }
    for(unsigned block=0;block<400;block++) process_half(scans,1);
    close_to(MeasureResult.leakage_adc_rms,0,0.00001f,"LPF removes alternating half-count Nyquist noise around fractional offset");
    check(adc_offset[ADC_CH_ILEAK]==2036 && !MeasureResult.leakage_trip_flag,
          "fractional DC level does not falsely trigger fast leakage");

    /* Fast protection must compare both polarities around the actual DC level. */
    for(int polarity=-1;polarity<=1;polarity+=2)
    {
      for(int amplitude=7;amplitude<=9;amplitude+=2)
      {
        reset_measurement();
        for(unsigned j=0;j<10;j++)
        {
            for(unsigned ch=0;ch<5;ch++) scans[j*5+ch]=2048;
            scans[j*5+ADC_CH_ILEAK]=2036;
        }
        for(unsigned block=0;block<200;block++) process_half(scans,1);
        for(unsigned j=0;j<10;j++) scans[j*5+ADC_CH_ILEAK]=(uint16_t)(2036+polarity*amplitude);
        for(unsigned block=0;block<FAST_TEST_BLOCKS;block++) process_half(scans,1);
        check(MeasureResult.leakage_trip_flag==(amplitude==9),
              "filtered sustained 7/9-count inputs remain either side of the 8-count threshold");
      }
    }

    reset_measurement();
    feed(8000,50,220,5,0.4,0.010,25,0,0,0,0,1);
    MeasureResult_t reference=MeasureResult;
    reset_measurement();
    channel_bias[0]=-0.045; channel_bias[1]=0.071;
    channel_bias[2]=-0.032; channel_bias[3]=-0.013;
    feed(8000,50,220,5,0.4,0.010,25,0,0,0,0,1);
    close_to(MeasureResult.V_in_rms,reference.V_in_rms,0.2f,"Vin RMS independent of its DC bias");
    close_to(MeasureResult.V_out_rms,reference.V_out_rms,0.2f,"Vout RMS independent of its DC bias");
    close_to(MeasureResult.I_in_rms,reference.I_in_rms,0.01f,"current RMS independent of its DC bias");
    close_to(MeasureResult.I_leak_rms,reference.I_leak_rms,0.001f,"leakage RMS independent of its DC bias");
    close_to(MeasureResult.P_in_active,reference.P_in_active,3.0f,"power removes independent Vin/current biases");
    close_to(MeasureResult.Frequency_in,50,0.03f,"frequency uses learned Vin bias");
    check(!MeasureResult.leakage_trip_flag && mock_cross_count>40,
          "shifted channel biases retain leakage and zero-cross behavior");
    printf("DC bias audit: Ileak offset=%.6f V, RMS=%.3f mA, fast=%u\n",
           MeasureResult.I_leak_DC_Offset,MeasureResult.I_leak_rms*1000,MeasureResult.leakage_trip_flag);
    reset_measurement();
}

static uint32_t float_ulp_distance(float a, float b)
{
    FloatBits_t x, y; x.value=a; y.value=b;
    return x.bits>y.bits ? x.bits-y.bits : y.bits-x.bits;
}

static void fill_leak_scans(uint16_t scans[50], uint16_t raw)
{
    for(unsigned j=0;j<10;j++)
        for(unsigned ch=0;ch<5;ch++)
            scans[j*5+ch]=(ch==ADC_CH_ILEAK)?raw:2048;
}

static void feed_leak_dc(uint16_t raw, unsigned blocks, int run_main)
{
    uint16_t scans[50];
    fill_leak_scans(scans,raw);
    for(unsigned block=0;block<blocks;block++) process_half(scans,run_main);
}

static void test_fast_offset_tracking(void)
{
    _Static_assert(sizeof(MeasureResult_t)==80 &&
                   offsetof(MeasureResult_t,leakage_adc_rms)==56 &&
                   offsetof(MeasureResult_t,I_leak_peak_max)==68 &&
                   offsetof(MeasureResult_t,leakage_over_count_max)==76,
                   "Maxima append to results without moving legacy fields");
    uint16_t scans[50];
    FakeFlash_Reset();
    reset_measurement();
    feed_leak_dc(2036,100,1);
    check(!MeasureResult.fast_leakage_ready,"fast baseline is not armed after only 100 ms");
    feed_leak_dc(2042,100,1);
    check(MeasureResult.startup_complete && !MeasureResult.fast_leakage_ready,
          "different half-window means reject moving startup bias while publishing RMS");
    feed_leak_dc(2042,200,1);
    check(MeasureResult.fast_leakage_ready && !MeasureResult.leakage_trip_flag,
          "next stable window seeds actual baseline without startup leakage trip");
    close_to((float)leakage_offset_q19/LEAK_OFFSET_SCALE,2042,0.00001f,
             "stable startup replaces any assumed midpoint");

    reset_measurement();
    fill_leak_scans(scans,2036);
    scans[ADC_CH_ILEAK]=0;
    process_half(scans,1);
    feed_leak_dc(2036,199,1);
    check(!MeasureResult.fast_leakage_ready &&
          (MeasureResult.adc_clipped_mask&ADC_CLIPPED_ILEAK),
          "one clipped startup sample prevents baseline qualification");
    feed_leak_dc(2036,200,1);
    check(MeasureResult.fast_leakage_ready,"clean window can qualify after startup clipping");

    reset_measurement();
    feed_leak_dc(2036,100,1);
    feed_leak_dc(2037,100,1);
    check(MeasureResult.fast_leakage_ready,"one-count half-window mean difference is accepted");
    close_to((float)leakage_offset_q19/LEAK_OFFSET_SCALE,2036.5f,0.00001f,
             "startup seed preserves half-count bias");

    for(int polarity=-1;polarity<=1;polarity+=2)
    {
        reset_measurement();
        fill_leak_scans(scans,2036);
        for(unsigned j=0;j<10;j++) scans[j*5+ADC_CH_ILEAK]=(j&1)?2035:2036;
        for(unsigned block=0;block<200;block++) process_half(scans,1);
        close_to((float)leakage_offset_q19/LEAK_OFFSET_SCALE,2035.5f,0.00001f,
                 "fast offset is fractional, independent of rounded adc_offset");
        for(unsigned j=0;j<10;j++) scans[j*5+ADC_CH_ILEAK]=(polarity>0)?2043:2028; /* +/-7.5 counts */
        process_half(scans,0);
        check(!MeasureResult.leakage_trip_flag,"7.5-count peak below fractional threshold stays clear");
        for(unsigned j=0;j<10;j++) scans[j*5+ADC_CH_ILEAK]=(polarity>0)?2044:2027; /* +/-8.5 counts */
        for(unsigned block=0;block<FAST_TEST_BLOCKS;block++) process_half(scans,0);
        check(MeasureResult.leakage_trip_flag,"8.5-count peak trips around fractional baseline");
    }

    for(int polarity=-1;polarity<=1;polarity+=2)
    {
        reset_measurement();
        feed_leak_dc(2036,200,1);
        for(unsigned block=0;block<4000;block++)
        {
            for(unsigned j=0;j<10;j++)
            {
                for(unsigned ch=0;ch<5;ch++) scans[j*5+ch]=2048;
                scans[j*5+ADC_CH_ILEAK]=(uint16_t)(2036+polarity*(int)((block*10+j)/5000));
            }
            process_half(scans,0); /* Slow tracking must not depend on main. */
        }
        check(!MeasureResult.leakage_trip_flag,"slow DC drift is tracked in either polarity without false trip");
        close_to((float)leakage_offset_q19/LEAK_OFFSET_SCALE,(float)(2036+polarity*7),3.0f,
                 "continuous offset follows two-count/second drift despite an unconsumed snapshot");
        check(abs(leakage_offset_q19-2036*LEAK_OFFSET_SCALE)>4*LEAK_OFFSET_SCALE,
              "offset actually adapts instead of remaining at startup mean");

        reset_measurement();
        feed_leak_dc(2036,200,1);
        int32_t before=leakage_offset_q19;
        feed_leak_dc((uint16_t)(2036+polarity*12),FAST_TEST_BLOCKS,0);
        check(MeasureResult.leakage_trip_flag,"abrupt step is tested before offset learning");
        check(FastLeakTrip.valid && FastLeakTrip.raw_adc_count==2036+polarity*12 &&
              FastLeakTrip.threshold_adc_count==leak_trip_counts &&
              FastLeakTrip.sample_index==WINDOW_SAMPLES+MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES+1,
              "first-trip snapshot captures raw input, configured threshold and actual sample timestamp");
        check(polarity*FastLeakTrip.delta_adc_count>=FastLeakTrip.threshold_adc_count,
              "first-trip evidence proves signed filtered deviation crossed the threshold");
        close_to(FastLeakTrip.offset_adc_count,2036,0.01f,
                 "first-trip evidence records the offset used in the comparison");
        float captured=FastLeakTrip.filtered_adc_count;
        check(abs(leakage_offset_q19-before)<LEAK_OFFSET_SCALE/100,
              "baseline moves less than 0.01 count before filtered step reaches threshold");
        before=leakage_offset_q19;
        feed_leak_dc((uint16_t)(2036+polarity*12),1000,1);
        check(leakage_offset_q19==before && MeasureResult.leakage_trip_flag,
              "latched fast event freezes baseline and cannot be learned away");
        check(FastLeakTrip.filtered_adc_count==captured &&
              FastLeakTrip.sample_index==WINDOW_SAMPLES+MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES+1,
              "later samples cannot overwrite first-trip evidence");
    }

    reset_measurement();
    feed_leak_dc(2036,200,1);
    check(!FastLeakTrip.valid,"new boot clears first-trip evidence while healthy baseline is ready");
    feed_leak_dc(2037,819,0);
    close_to((float)leakage_offset_q19/LEAK_OFFSET_SCALE,
             (float)(2036+1-exp(-8190.0/8192)),0.02f,
             "subthreshold step follows approximately 0.8192-second time constant");

    for(unsigned hz=50;hz<=60;hz+=10)
    {
        reset_measurement();
        feed(30000,hz,220,1,0,0.020,25,0,0,0,0,1);
        check(MeasureResult.fast_leakage_ready && !MeasureResult.leakage_trip_flag,
              "continuous 20 mA RMS at 50/60 Hz stays below configured peak threshold");
        close_to((float)leakage_offset_q19/LEAK_OFFSET_SCALE,
                 (1.65f+0.003f)/ADC_LSB_V,0.12f,
                 "slow baseline does not follow the 50/60 Hz waveform");
    }

    reset_measurement();
    feed_leak_dc(2036,200,1);
    for(unsigned block=0;block<100;block++)
    {
        fill_leak_scans(scans,2036);
        for(unsigned j=0;j<10;j++)
        {
            double phase=2*3.14159265358979323846*(block*10+j)/200;
            scans[j*5+ADC_CH_ILEAK]=(uint16_t)(2036+lround(10*fmax(0,sin(phase))));
        }
        process_half(scans,0);
    }
    check(MeasureResult.leakage_trip_flag,
          "asymmetric half-wave pulse crossing the peak threshold is not learned away");

    reset_measurement();
    feed_leak_dc(3,200,1);
    leak_trip_counts=100;
    int32_t clipped_baseline=leakage_offset_q19;
    feed_leak_dc(0,1,0);
    feed_leak_dc(4,199,1);
    check(!MeasureResult.leakage_trip_flag && leakage_offset_q19==clipped_baseline,
          "clipped window freezes learning even below fast threshold");
    feed_leak_dc(4,1,0);
    check(leakage_offset_q19>clipped_baseline,"clean window resumes slow tracking after clipping");

    reset_measurement();
    leak_trip_counts=100; /* Isolate the separate RMS fault hold. */
    feed(4000,50,220,1,0,0.035,25,0,0,0,0,1);
    check(MeasureResult.fast_leakage_ready && leakage_offset_hold && !MeasureResult.leakage_trip_flag,
          "RMS leakage fault freezes learning even when fast threshold is higher");
    int32_t before=leakage_offset_q19;
    feed_leak_dc(2055,200,1);
    check(leakage_offset_q19==before,"RMS fault hold survives later quiet windows");
    feed_leak_dc(2200,FAST_TEST_BLOCKS,0);
    check(MeasureResult.leakage_trip_flag,"holding the estimator does not disable fast detection");

    static const uint16_t extremes[]={3,4092};
    for(unsigned i=0;i<2;i++)
    {
        reset_measurement();
        feed_leak_dc(extremes[i],200,1);
        check(MeasureResult.fast_leakage_ready,"valid near-rail DC bias can seed without integer overflow");
        feed_leak_dc(i?0:4095,(MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES+9U)/10U,0);
        check(MeasureResult.leakage_trip_flag,"full-range ADC step trips without signed overflow");
    }
    FakeFlash_Reset();
    reset_measurement();
}

static void test_fast_confirmation(void)
{
    _Static_assert(MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES==20,
                   "Shipping fast leakage qualifier must require twenty samples");
    uint16_t scans[50];
    for(int polarity=-1;polarity<=1;polarity+=2)
    {
        reset_measurement();
        feed_leak_dc(2036,200,1);
        int32_t baseline=leakage_offset_q19;
        for(unsigned burst=0;burst<3;burst++)
        {
            for(unsigned n=1;n<MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES;n++)
            {
                ProcessFastLeakage((2036+polarity*8)*SIGNAL_SCALE,(uint16_t)(2036+polarity*8));
                check(!MeasureResult.leakage_trip_flag && !FastLeakTrip.valid,
                      "one through nineteen equal-threshold samples do not latch or publish a trip");
                check(leakage_over_count==n && leakage_over_count_max>=n,
                      "live counter advances on every qualifying sample and retains its high-water mark");
                check(leakage_offset_q19==baseline,"candidate samples cannot move the fast baseline");
            }
            ProcessFastLeakage(2036*SIGNAL_SCALE,2036);
            check(!leakage_over_count,"a below-threshold sample cancels the whole candidate");
            check(leakage_over_count_max==MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES-1,
                  "candidate reset cannot erase the longest observed sequence");
        }
        for(unsigned n=1;n<MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES;n++)
            ProcessFastLeakage((2036+polarity*8)*SIGNAL_SCALE,(uint16_t)(2036+polarity*8));
        check(!MeasureResult.leakage_trip_flag,"old incomplete bursts are not accumulated");
        ProcessFastLeakage((2036+polarity*8)*SIGNAL_SCALE,(uint16_t)(2036+polarity*8));
        check(MeasureResult.leakage_trip_flag && FastLeakTrip.valid && leakage_over_count==20,
              "twentieth consecutive sample confirms a trip in either polarity");
        check(leakage_over_count_max==20,"confirmed trip retains full sequence length");
        Measurement_MainFunction();
        check(MeasureResult.leakage_over_count_max==20,
              "main publishes confirmed sequence length without waiting for an RMS window");
        close_to(FastLeakTrip.delta_adc_count,(float)(polarity*8),0.00001f,
                 "first-trip evidence belongs to the confirmation sample");

        reset_measurement();
        feed_leak_dc(2036,200,1);
        fill_leak_scans(scans,2036);
        scans[ADC_CH_ILEAK]=(uint16_t)(2036+polarity*50);
        process_half(scans,1);
        check(!MeasureResult.leakage_trip_flag && !FastLeakTrip.valid && !leakage_over_count,
              "single raw impulse stretched into three LPF exceedances is rejected");
        check(leakage_over_count_max==3 && MeasureResult.leakage_over_count_max==3,
              "three-sample impulse remains visible after current count returns to zero within DMA");
        check(MeasureResult.I_leak_peak_max>0.070f,
              "rejected impulse still appears in retained peak maximum");

        reset_measurement();
        feed_leak_dc(2036,200,1);
        fill_leak_scans(scans,2036);
        scans[ADC_CH_ILEAK]=(uint16_t)(2036+polarity*40);
        process_half(scans,1);
        check(!leakage_over_count && leakage_over_count_max==2 &&
              MeasureResult.leakage_over_count_max==2 && !MeasureResult.leakage_trip_flag,
              "two-sample excursion is retained even when live polling only sees zero at DMA end");
    }

    /* Three exceedances at one DMA end; remaining samples span later halves. */
    for(unsigned window_edge=0;window_edge<2;window_edge++)
    {
        reset_measurement();
        feed_leak_dc(2036,200,1);
        if(window_edge) feed_leak_dc(2036,199,1);
        fill_leak_scans(scans,2036);
        for(unsigned j=5;j<10;j++) scans[j*5+ADC_CH_ILEAK]=2048;
        process_half(scans,1);
        check(!MeasureResult.leakage_trip_flag && leakage_over_count==3,
              "DMA/window end preserves a partial three-sample candidate");
        feed_leak_dc(2048,(MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES-3U+9U)/10U,1);
        check(MeasureResult.leakage_trip_flag && FastLeakTrip.valid &&
              FastLeakTrip.sample_index==(window_edge?
                  2*WINDOW_SAMPLES+MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES-4:
                  WINDOW_SAMPLES+MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES+6),
              "twentieth sample across DMA and RMS-window boundary confirms at the correct timestamp");
    }

    reset_measurement();
    feed_leak_dc(2036,200,1);
    for(unsigned n=1;n<MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES;n++)
        ProcessFastLeakage(2044*SIGNAL_SCALE,2044);
    MeasureResult.fast_leakage_ready=0;
    ProcessFastLeakage(2044*SIGNAL_SCALE,2044);
    check(!leakage_over_count && !MeasureResult.leakage_trip_flag,
          "loss of baseline readiness cancels a candidate");
    MeasurementInit();
    check(!leakage_over_count && !leakage_over_count_max &&
          !MeasureResult.leakage_over_count_max && !FastLeakTrip.valid,
          "measurement initialization clears current count, high-water mark and trip evidence");
    reset_measurement();
}

/* Device-retained maxima, independent of PC polling and the first-trip log. */
static void test_leakage_maxima(void)
{
    FakeFlash_Reset();
    reset_measurement();
    check(MeasureResult.I_leak_peak_max==0 && MeasureResult.I_leak_rms_max==0,
          "new boot clears both leakage maxima");
    feed_leak_dc(2036,100,1);
    feed_leak_dc(2042,100,1);
    check(!MeasureResult.fast_leakage_ready && MeasureResult.I_leak_peak_max==0 &&
          MeasureResult.I_leak_rms_max>0.005f,
          "RMS maximum includes startup while peak waits for a qualified baseline");
    float startup_rms_max=MeasureResult.I_leak_rms_max;
    feed_leak_dc(2042,400,1);
    check(MeasureResult.I_leak_rms<0.001f && MeasureResult.I_leak_rms_max==startup_rms_max,
          "quiet windows cannot erase RMS startup maximum");

    reset_measurement();
    feed_leak_dc(2036,200,1);
    feed_leak_dc(2048,FAST_TEST_BLOCKS,0); /* A brief event between 500 ms polls. */
    check(MeasureResult.leakage_trip_flag && !data_ready_flag,
          "peak event occurs without another complete RMS window");
    uint32_t trip_index=FastLeakTrip.sample_index;
    float first_trip=FastLeakTrip.filtered_adc_count;
    Measurement_MainFunction();
    float peak=MeasureResult.I_leak_peak_max;
    check(peak>0.045f && peak<0.051f && MeasureResult.I_leak_rms_max==0,
          "main publishes retained filtered peak in amperes even without a complete window");
    feed_leak_dc(2036,20,1);
    check(MeasureResult.I_leak_peak_max==peak,"quiet samples retain a peak between PC polls");
    feed_leak_dc(2012,1,1);
    check(MeasureResult.I_leak_peak_max>peak*1.9f &&
          FastLeakTrip.sample_index==trip_index && FastLeakTrip.filtered_adc_count==first_trip,
          "larger opposite-polarity post-trip peak updates maximum but preserves first-trip evidence");
    feed_leak_dc(2036,200,1);
    float rms=MeasureResult.I_leak_rms_max;
    check(rms>0,"RMS maximum records a later completed event window");
    feed_leak_dc(2036,600,1);
    check(MeasureResult.I_leak_rms<0.001f && MeasureResult.I_leak_rms_max==rms,
          "RMS maximum remains after event disappears");
    reset_measurement();
    check(MeasureResult.I_leak_peak_max==0 && MeasureResult.I_leak_rms_max==0,
          "reset clears retained maxima after a trip");
}

/* Independent frequency response, raw diagnostics and filtered fast timing. */
static void test_adc_lowpass(void)
{
    static const double frequencies[]={1,10,50,60,500,1000,2500,4500};
    for(unsigned which=0;which<2;which++)
    {
        double cutoff=which?MEASUREMENT_TEMP_BANDWIDTH_HZ:MEASUREMENT_LEAK_BANDWIDTH_HZ;
        for(unsigned f=0;f<sizeof(frequencies)/sizeof(frequencies[0]);f++)
        {
            double frequency=frequencies[f], energy=0;
            FilterState_t state={0};
            for(unsigned n=0;n<40000;n++)
            {
                int raw=(int)lround(2048+256*sin(2*3.14159265358979323846*frequency*n/10000));
                double ac=(double)FilterAdcSample(&state,raw,which?TEMP_FILTER_A:LEAK_FILTER_A)/SIGNAL_SCALE-2048;
                if(n>=20000) energy+=ac*ac;
            }
            /* Independent frequency-domain response of a bilinear RC LPF. */
            double expected=1/hypot(1,10000/(3.14159265358979323846*cutoff)*
                                      tan(3.14159265358979323846*frequency/10000));
            close_to((float)(sqrt(energy/20000)/(256/sqrt(2.0))),(float)expected,0.002f,
                     "ADC low-pass gain agrees with independent frequency response");
        }
    }

    reset_measurement();
    uint16_t scans[50];
    for(unsigned block=0;block<1000;block++)
    {
        for(unsigned j=0;j<10;j++)
            for(unsigned ch=0;ch<5;ch++)
                scans[j*5+ch]=(uint16_t)((ch==ADC_CH_TEMP?2048:2036)+((j&1)?20:-20));
        process_half(scans,1);
    }
    close_to(MeasureResult.V_in_rms,0,0.01f,"Vin ADC noise is removed before inverse-RC amplification");
    close_to(MeasureResult.V_out_rms,0,0.01f,"Vout ADC noise is removed before inverse-RC amplification");
    close_to(MeasureResult.I_in_rms,0,0.001f,"Iin uses matching ADC low-pass pole");
    close_to(MeasureResult.I_leak_rms,0,0.00001f,"Ileak RMS uses low-pass ADC signal");
    close_to(MeasureResult.temperature_adc_average,2048,0.02f,"NTC low-pass suppresses high-frequency noise without DC shift");
    check(!MeasureResult.leakage_trip_flag && MeasureResult.fast_leakage_ready,
          "20-count alternating raw noise does not falsely trip filtered fast path");

    for(int polarity=-1;polarity<=1;polarity+=2)
    {
        reset_measurement();
        feed_leak_dc(2036,200,1);
        fill_leak_scans(scans,2036);
        scans[ADC_CH_ILEAK]=(uint16_t)(2036+polarity*8);
        process_half(scans,0);
        check(!MeasureResult.leakage_trip_flag,"isolated 100-us eight-count spike is attenuated by LPF");
        feed_leak_dc(2036,20,0);
        uint16_t scan[5]={2048,2048,2048,(uint16_t)(2036+polarity*12),2048};
        unsigned crossing=0;
        for(unsigned n=1;n<=MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES+10U;n++)
        {
            Process_Buffer_Segment(scan,NUM_CHANNELS);
            if(MeasureResult.leakage_trip_flag) {crossing=n;break;}
        }
        check(crossing==2+MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES,
              "12-count step trips after LPF crossing plus consecutive-sample confirmation");

        reset_measurement();
        feed_leak_dc(2036,200,1);
        fill_leak_scans(scans,2036);
        scans[ADC_CH_ILEAK]=(uint16_t)(2036+polarity*100);
        process_half(scans,0);
        check(!MeasureResult.leakage_trip_flag,"100-count raw impulse gives fewer than twenty filtered exceedances");
        reset_measurement();
        feed_leak_dc(2036,200,1);
        fill_leak_scans(scans,2036);
        for(unsigned j=0;j<10;j++) scans[j*5+ADC_CH_ILEAK]=(uint16_t)(2036+polarity*200);
        for(unsigned block=0;block<(MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES+9U)/10U;block++)
            process_half(scans,0);
        check(MeasureResult.leakage_trip_flag &&
              FastLeakTrip.sample_index==WINDOW_SAMPLES+MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES-1,
              "larger pulse confirms on the twentieth filtered exceedance");
    }

    const uint16_t invalid_ntc[]={4,4092}; /* Invalid NTC, but not ADC clipping. */
    for(unsigned which=0;which<2;which++)
    {
        reset_measurement();
        feed_leak_dc(2036,200,1);
        fill_leak_scans(scans,2036);
        for(unsigned j=0;j<10;j++) scans[j*5+ADC_CH_TEMP]=invalid_ntc[which];
        for(unsigned block=0;block<200;block++) process_half(scans,1);
        check(MeasureResult.temperature_fault && isnan(MeasureResult.Temperature) &&
              !(MeasureResult.adc_clipped_mask&ADC_CLIPPED_TEMP),
              "NTC raw-mean open/short is detected in first window despite LPF settling");
    }
    reset_measurement();
    feed_leak_dc(2036,200,1);
    fill_leak_scans(scans,2036);
    for(unsigned j=0;j<10;j++) scans[j*5+ADC_CH_TEMP]=ntc_code(85);
    for(unsigned block=0;block<200;block++) process_half(scans,1);
    check(MeasureResult.Temperature>70 && !MeasureResult.temperature_fault,
          "25-to-85 C step still exceeds overtemperature threshold in first 200-ms window");
    for(unsigned block=0;block<200;block++) process_half(scans,1);
    close_to(MeasureResult.Temperature,85,0.2f,"filtered temperature settles without changing NTC conversion");
    reset_measurement();
    fill_leak_scans(scans,2036);
    for(unsigned block=0;block<200;block++) process_half(scans,1);
    scans[ADC_CH_ILEAK]=4095;
    process_half(scans,1);
    fill_leak_scans(scans,2036);
    for(unsigned block=0;block<199;block++) process_half(scans,1);
    check(MeasureResult.adc_clipped_mask&ADC_CLIPPED_ILEAK,
          "LPF cannot hide a single raw clipped sample from diagnostics");
    reset_measurement();
}

/* Independent reference: explicitly convert every sample to ADC volts, subtract
 * a real voltage offset, square/multiply, then average in double precision.
 * Includes fractional filter outputs and a deliberately shifted offset so a
 * helper that ignores its real offset and merely removes the mean will fail. */
static void test_real_voltage_offsets(void)
{
    static const int bases[AC_CHANNELS]={1875,2102,1950,2036};
    static const int pattern[8]={-4,-3,-2,-1,0,1,2,3};
    Window_t window;
    memset(&window,0,sizeof(window));
    for(unsigned sample=0;sample<WINDOW_SAMPLES;sample++)
    {
        int32_t signal[AC_CHANNELS];
        for(unsigned ch=0;ch<AC_CHANNELS;ch++)
        {
            int raw=bases[ch]+pattern[(sample+ch)%8];
            signal[ch]=raw*SIGNAL_SCALE+(int)(ch+1)*((int)(sample%3)-1)*19;
            window.raw_sum[ch]+=(uint32_t)raw;
            window.sum[ch]+=signal[ch];
            window.sum_sq[ch]+=(uint64_t)((int64_t)signal[ch]*signal[ch]);
        }
        window.power_sum+=(int64_t)signal[0]*signal[2];
    }
    for(unsigned shifted=0;shifted<2;shifted++)
    {
        float offsets[AC_CHANNELS],means[AC_CHANNELS];
        double expected_square[AC_CHANNELS]={0},expected_mean[AC_CHANNELS]={0};
        double expected_power=0;
        for(unsigned ch=0;ch<AC_CHANNELS;ch++)
            offsets[ch]=(float)window.raw_sum[ch]*(ADC_LSB_V/WINDOW_SAMPLES)
                        +(shifted?(float)(ch+1)*0.0007f:0);
        for(unsigned sample=0;sample<WINDOW_SAMPLES;sample++)
        {
            double ac_v[AC_CHANNELS];
            for(unsigned ch=0;ch<AC_CHANNELS;ch++)
            {
                int raw=bases[ch]+pattern[(sample+ch)%8];
                int q8=raw*SIGNAL_SCALE+(int)(ch+1)*((int)(sample%3)-1)*19;
                ac_v[ch]=(double)q8*((double)ADC_LSB_V/SIGNAL_SCALE)-(double)offsets[ch];
                expected_mean[ch]+=ac_v[ch]/WINDOW_SAMPLES;
                expected_square[ch]+=ac_v[ch]*ac_v[ch]/WINDOW_SAMPLES;
            }
            expected_power+=ac_v[0]*ac_v[2]/WINDOW_SAMPLES;
        }
        for(unsigned ch=0;ch<AC_CHANNELS;ch++)
        {
            float actual=WindowAcMeanSquare(&window,ch,offsets[ch],&means[ch]);
            close_to(actual,(float)expected_square[ch],2e-9f,"RMS moments match per-sample voltage-offset subtraction");
            close_to(means[ch],(float)expected_mean[ch],2e-7f,"AC mean honors the supplied real voltage offset");
        }
        close_to(WindowAcPower(&window,offsets,means),(float)expected_power,2e-9f,
                 "power matches per-sample subtraction of both real offsets");
    }

    /* Tiny AC over a large DC voltage must retain sub-count resolution. */
    static const unsigned dc_codes[]={100,1200,2036,2800,4000};
    for(unsigned n=0;n<sizeof(dc_codes)/sizeof(dc_codes[0]);n++)
    {
        memset(&window,0,sizeof(window));
        for(unsigned sample=0;sample<WINDOW_SAMPLES;sample++)
        {
            unsigned raw=dc_codes[n]+(sample&1);
            int64_t q8=(int64_t)raw*SIGNAL_SCALE;
            window.raw_sum[ADC_CH_ILEAK]+=raw;
            window.sum[ADC_CH_ILEAK]+=q8;
            window.sum_sq[ADC_CH_ILEAK]+=(uint64_t)(q8*q8);
        }
        float offset_v=(float)window.raw_sum[ADC_CH_ILEAK]*(ADC_LSB_V/WINDOW_SAMPLES);
        float ac_mean;
        float rms_v=MeasurementSqrt(WindowAcMeanSquare(&window,ADC_CH_ILEAK,offset_v,&ac_mean));
        close_to(rms_v,0.5f*ADC_LSB_V,2e-8f,"half-count RMS survives real offset removal across the ADC range");
    }
}

static void test_compact_math(void)
{
    unsigned bad_conversions=0, bad_roots=0, bad_logs=0, bad_temperatures=0;
    uint32_t max_conversion_ulps=0, random_state=0x13579bdfU;
    double max_root_relative_error=0, max_log_error=0, max_temperature_error=0;
    const uint64_t edges[]={0,1,UINT32_MAX,(uint64_t)UINT32_MAX+1U,
        UINT64_MAX,UINT64_MAX-1U,(uint64_t)INT64_MAX,(uint64_t)INT64_MIN,
        UINT64_C(0x0100000080000001),UINT64_C(0x00ffffff80000001)};
    for(unsigned n=0;n<100010U;n++)
    {
        random_state=random_state*1664525U+1013904223U;
        uint64_t value=(uint64_t)random_state<<32;
        random_state=random_state*1664525U+1013904223U;
        value|=random_state;
        if(n<10U) value=edges[n];
        uint32_t ulps=float_ulp_distance(Unsigned64ToFloat(value),(float)value);
        if(ulps>max_conversion_ulps) max_conversion_ulps=ulps;
        if(ulps>1U) bad_conversions++;
        ulps=float_ulp_distance(Signed64ToFloat((int64_t)value),(float)(int64_t)value);
        if(ulps>max_conversion_ulps) max_conversion_ulps=ulps;
        if(ulps>1U) bad_conversions++;
    }
    check(bad_conversions==0,"64-bit conversion edges/random sweep within one float ULP");
    for(uint32_t exponent=1;exponent<255;exponent++)
    {
        for(uint32_t mantissa=0;mantissa<0x800000U;mantissa+=65537U)
        {
            FloatBits_t sample; sample.bits=(exponent<<23)|mantissa;
            double reference=sqrt((double)sample.value);
            double error=fabs((double)MeasurementSqrt(sample.value)-reference)/reference;
            if(error>max_root_relative_error) max_root_relative_error=error;
            if(error>2.0e-7) bad_roots++;
        }
    }
    check(bad_roots==0,"compact sqrt sweep across all positive normal float exponents");
    close_to(MeasurementSqrt(0),0,0,"compact sqrt handles zero variance");
    for(unsigned code=MEASUREMENT_NTC_ADC_RAIL_MARGIN+1U;
        code<(unsigned)MEASUREMENT_ADC_COUNTS-MEASUREMENT_NTC_ADC_RAIL_MARGIN;code++)
    {
        float ratio=(float)code/(4096.0f-(float)code);
        double error=fabs((double)MeasurementLog(ratio)-log((double)ratio));
        if(error>max_log_error) max_log_error=error;
        if(error>1.0e-6) bad_logs++;
        double temperature=1.0/(1.0/(double)MEASUREMENT_NTC_T0_K+
            log((double)code/(4096.0-code))/(double)MEASUREMENT_NTC_BETA_K)-273.15;
        error=fabs((double)ConvertTemperature((float)code)-temperature);
        if(error>max_temperature_error) max_temperature_error=error;
        if(error>0.001) bad_temperatures++;
    }
    check(bad_logs==0,"compact log sweep over every valid NTC ADC code");
    check(bad_temperatures==0,"NTC conversion sweep stays within 0.001C of double reference");
    printf("Compact math: max conversion=%u ULP, sqrt relative=%.3g, log absolute=%.3g, NTC=%.6f C\n",
        max_conversion_ulps,max_root_relative_error,max_log_error,max_temperature_error);
}

static void test_compact_subtraction(void)
{
    static const uint32_t edges[]={0,0x80000000U,1,0x80000001U,0x007fffffU,
        0x00800000U,0x3f800000U,0xbf800000U,0x7f7fffffU,0xff7fffffU,
        0x7f800000U,0xff800000U,0x7fc00001U,0xffc00001U};
    unsigned mismatches=0;
    uint32_t rng=0x473cb19aU;
    for(unsigned i=0;i<200000U;i++)
    {
        FloatBits_t left,right,expected,actual;
        rng=rng*1664525U+1013904223U; left.bits=rng;
        rng=rng*1664525U+1013904223U; right.bits=rng;
        if(i<sizeof(edges)/sizeof(edges[0])*sizeof(edges)/sizeof(edges[0]))
        {
            left.bits=edges[i/(sizeof(edges)/sizeof(edges[0]))];
            right.bits=edges[i%(sizeof(edges)/sizeof(edges[0]))];
        }
        expected.value=left.value-right.value;
        actual.value=MeasurementSubtract(left.value,right.value);
        if(isnan(expected.value)) mismatches+=!isnan(actual.value);
        else mismatches+=expected.bits!=actual.bits;
    }
    check(mismatches==0,"compact subtraction matches native IEEE-754 results including signed zero and infinities");
}

int main(void)
{
    test_compact_math();
    test_compact_subtraction();
    test_real_voltage_offsets();
    test_actual_dc_bias();
    test_fast_offset_tracking();
    test_adc_lowpass();
    test_fast_confirmation();
    test_leakage_maxima();
    reset_measurement();
    check(mock_timer_running && mock_dma_running,"init enables timer and DMA");
    close_to(MEASUREMENT_NTC_BETA_K,3435.0f,0,"TDK NTCG163JF103HT1 B25/85 configuration");
    close_to(MEASUREMENT_LEAK_CT_RATIO,1000.0f,0,"ZMCT118F rated 5A/5mA ratio");
    close_to(VIN_V_PER_COUNT,0.23029785156f,0.000001f,"9.4M/33k voltage conversion");
    close_to(IIN_A_PER_COUNT,0.04833984375f,0.000001f,"three parallel 0.05R shunts");
    close_to(LEAK_EFFECTIVE_R,191.8367347f,0.0001f,"CT burden includes amplifier loading");
    close_to(LEAK_A_PER_COUNT,0.0041997382f,0.0000001f,"1000:1 CT low-frequency conversion");

    for(unsigned f=50;f<=60;f+=10)
    {
        for(unsigned pfcase=0;pfcase<3;pfcase++)
        {
            double phase=pfcase==0?0:(pfcase==1?1.047197551196598:-1.047197551196598);
            reset_measurement();
            feed(12000,f,220,5,phase,0.030,25,0,0,0,0,1);
            double h=1.0/(1.0+pow(f/1000.0,2)); /* Two matched low-pass poles. */
            close_to(MeasureResult.V_in_rms,220*h,0.35f,"50/60Hz voltage after RC recovery");
            close_to(MeasureResult.V_out_rms,176*h,0.35f,"output-voltage RC recovery");
            close_to(MeasureResult.I_in_rms,5*h,0.015f,"line-current scale and matched filter");
            close_to(MeasureResult.P_in_active,1100*h*h*cos(phase),5.0f,"RC phase and ADC skew corrected power");
            close_to(MeasureResult.PowerFactor_in,cos(phase),0.006f,"unity/leading/lagging PF");
            close_to(MeasureResult.Frequency_in,f,0.025f,"interpolated frequency");
            close_to(MeasureResult.I_leak_rms,0.030f,0.0015f,"30mA leakage RMS");
            close_to(MeasureResult.Temperature,25,0.05f,"NTC 25C midpoint");
            check(MeasureResult.leakage_trip_flag==1,"30mA RMS exceeds 30mA peak flag");
            check(MeasureResult.adc_clipped_mask==ADC_CLIPPED_NONE,"valid waveform not clipped");
            close_to(RteTest_LeakageAdcRms(),MeasureResult.leakage_adc_rms,0,"Rte-only consumer reads shared leakage ADC RMS");
            close_to(RteTest_TemperatureAdcAverage(),2048,0,"Rte-only consumer reads shared temperature ADC average");
            printf("PASS sine %.0fHz PF %.1f: V=%.3f I=%.4f P=%.3f PF=%.5f f=%.5f\n",
                   (double)f,cos(phase),MeasureResult.V_in_rms,MeasureResult.I_in_rms,
                   MeasureResult.P_in_active,MeasureResult.PowerFactor_in,MeasureResult.Frequency_in);
        }
    }
    reset_measurement();
    feed(12000,50,220,5,0,0,25,44,2,0.7,0,1);
    double h1=1.0/(1.0+0.05*0.05), h3=1.0/(1.0+0.15*0.15);
    double expected_v=hypot(220*h1,44*h3), expected_i=hypot(5*h1,2*h3);
    double expected_p=1100*h1*h1+44*2*h3*h3*cos(0.7);
    close_to(MeasureResult.V_in_rms,expected_v,0.4f,"voltage RMS includes third harmonic");
    close_to(MeasureResult.I_in_rms,expected_i,0.02f,"current RMS includes third harmonic");
    close_to(MeasureResult.P_in_active,expected_p,6.0f,"power includes harmonic contribution");
    close_to(MeasureResult.PowerFactor_in,expected_p/(expected_v*expected_i),0.006f,"distorted-load true PF");

    reset_measurement();
    feed(12000,50,220,5,0,0.010,25,0,0,0,0.060,1);
    close_to(MeasureResult.V_in_rms,220*h1,0.4f,"same-window DC removal with shifted bias");
    close_to(MeasureResult.P_in_active,1100*h1*h1,5,"DC removed from power covariance");
    check(MeasureResult.leakage_trip_flag==0,"startup bias does not latch false leakage flag");
    check(MeasureResult.startup_complete==1,"startup diagnostics available");

    for(unsigned n=0;n<6;n++)
    {
        const double temperatures[6]={-40,0,25,50,85,125};
        close_to(ConvertTemperature(ntc_code(temperatures[n])),temperatures[n],0.20f,"TDK NTC Beta model at -40/0/25/50/85/125C");
    }
    check(isnan(ConvertTemperature(0)),"shorted NTC returns NAN");
    check(MeasureResult.temperature_fault==1,"NTC short diagnostic");
    check(isnan(ConvertTemperature(4095)),"open NTC returns NAN");
    ConvertTemperature(2048);
    check(MeasureResult.temperature_fault==0,"NTC diagnostic recovers");

    reset_measurement();
    feed(6000,50,0,0,0,0,25,0,0,0,0,1);
    close_to(MeasureResult.Frequency_in,0,0,"no invented 50Hz before AC appears");
    feed(6000,50,220,5,0,0,25,0,0,0,0,1);
    close_to(MeasureResult.Frequency_in,50,0.025f,"frequency locks after late AC arrival");
    feed(4000,50,0,0,0,0,25,0,0,0,0,1);
    close_to(MeasureResult.Frequency_in,0,0,"frequency expires after AC loss");

    reset_measurement();
    for(unsigned n=0;n<6000;n++) ProcessFrequency(((n%2)?5:-5)*SIGNAL_SCALE);
    close_to(frequency_raw,0,0,"sub-hysteresis zero chatter rejected");
    reset_measurement();
    sample_index=UINT32_MAX-2500; last_valid_index=last_cross_index=sample_index;
    feed(8000,50,220,5,0,0,25,0,0,0,0,1);
    close_to(MeasureResult.Frequency_in,50,0.025f,"frequency survives sample timestamp wrap");

    reset_measurement();
    feed(4000,50,220,5,0,0.020,25,0,0,0,0,1);
    check(MeasureResult.leakage_trip_flag==0,"20mA RMS stays below 30mA peak threshold");
    feed(2000,50,220,5,0,0.030,25,0,0,0,0,1);
    check(MeasureResult.leakage_trip_flag==1,"leakage flag trips on peak threshold");
    feed(2000,50,220,5,0,0,25,0,0,0,0,1);
    check(MeasureResult.leakage_trip_flag==1,"leakage flag remains latched");

    reset_measurement();
    feed(2000,50,220,5,0,0,25,0,0,0,0,0);
    check(data_ready_flag==1,"first complete window published");
    feed(2000,50,220,5,0,0,85,0,0,0,0,0);
    Measurement_MainFunction();
    close_to(MeasureResult.Temperature,25,0.05f,"busy snapshot not overwritten");
    feed(2000,50,220,5,0,0,85,0,0,0,0,1);
    close_to(MeasureResult.Temperature,85,0.2f,"next available window published");

    reset_measurement();
    uint16_t rails[50]; for(unsigned i=0;i<50;i++) rails[i]=2048;
    rails[0]=4095; rails[1]=0;
    process_half(rails,1);
    for(unsigned i=0;i<200;i++) rails[i%50]=2048;
    for(unsigned i=0;i<199;i++) process_half(rails,1);
    check(MeasureResult.adc_clipped_mask==(ADC_CLIPPED_VAC_IN|ADC_CLIPPED_VAC_OUT),"ADC rail diagnostics combine public Rte enum flags");
    check(RteTest_IsAdcClipped(ADC_CLIPPED_VAC_IN),"Rte-only consumer detects clipped input voltage");
    check(!RteTest_IsAdcClipped(ADC_CLIPPED_ILEAK),"Rte-only consumer distinguishes unclipped leakage");

    const AdcClippedMask_t channel_flags[5]={ADC_CLIPPED_VAC_IN,ADC_CLIPPED_VAC_OUT,ADC_CLIPPED_IAC,ADC_CLIPPED_ILEAK,ADC_CLIPPED_TEMP};
    for(unsigned ch=0;ch<5;ch++)
    {
        reset_measurement();
        for(unsigned segment=0;segment<200;segment++)
        {
            for(unsigned i=0;i<50;i++) rails[i]=2048;
            if(segment==0) rails[ch]=(ch%2)?0:4095;
            process_half(rails,1);
        }
        check(MeasureResult.adc_clipped_mask==channel_flags[ch],"each ADC channel maps to its public clipping enum");
        check(RteTest_IsAdcClipped(channel_flags[ch]),"Rte-only consumer reads each clipping flag");
        check(!RteTest_IsAdcClipped((AdcClippedMask_t)(ADC_CLIPPED_ALL^channel_flags[ch])),"other clipping bits remain clear");
    }
    /* Qualified compensated-Vin crossings: both edges, independent of 200 ms
     * publication, rejecting the divider's raw-ADC ~2.55 ms phase error. */
    for (unsigned hz=50; hz<=60; hz+=10)
    {
        reset_measurement();
        feed(2000,hz,220,1,0,0,25,0,0,0,0.060,1);
        check(mock_cross_count==0,"zero-cross hook stays disarmed during initial bias window");
        feed(10000,hz,220,1,0,0,25,0,0,0,0.060,1);
        check(mock_cross_count >= 2U*hz-3U && mock_cross_count <= 2U*hz,
            "zero-cross callback reports both edges at 50/60Hz");
        unsigned bad_phase=0, bad_spacing=0;
        double half_period=10000.0/(2.0*hz);
        for (unsigned n=0; n<mock_cross_count && n<256U; ++n)
        {
            double error=fabs(remainder((double)(mock_cross_indices[n]-1U),half_period));
            if (error>5.0) bad_phase++; /* <=500 us with the added ADC low-pass pole. */
            if (n>0 && fabs((double)(mock_cross_indices[n]-mock_cross_indices[n-1U])-half_period)>1.0)
                bad_spacing++;
        }
        check(bad_phase==0,"zero-cross phase uses compensated Vin with DC bias removed");
        check(bad_spacing==0,"both-edge spacing matches the mains half-period");
    }
    reset_measurement();
    feed(10000,50,0,0,0,0,25,0,0,0,0,1);
    check(mock_cross_count==0,"no relay crossings while AC is absent");
    adc_bias_ready=1;
    for (unsigned n=0;n<3000;n++)
    {
        sample_index++;
        ProcessZeroCrossing(((n%2)?5:-5)*SIGNAL_SCALE);
    }
    check(mock_cross_count==0,"sub-hysteresis chatter does not report relay crossings");
    for (unsigned n=0;n<3000;n++)
    {
        sample_index++;
        ProcessZeroCrossing(((n%2)?20:-20)*SIGNAL_SCALE);
    }
    check(mock_cross_count==0,"implausibly fast crossings are rejected");
    reset_measurement();
    sample_index=UINT32_MAX-2500; last_valid_index=last_cross_index=sample_index;
    feed(8000,50,220,1,0,0,25,0,0,0,0,1);
    check(mock_cross_count>40,"relay crossings survive sample timestamp wrap");

    /* Persisted gains apply at restart to RMS, power and the fast peak path. */
    FakeFlash_Reset(); reset_measurement();
    feed(8000,50,220,5,0,0.005,25,0,0,0,0,1);
    MeasureResult_t baseline = MeasureResult;
    CalibParams_t calib_params = {1.1f,0.9f,1.2f,1.5f,2.5f};
    check(Calib_Save(&calib_params)==CALIB_OK,"save calib before simulated reboot");
    reset_measurement();
    feed(8000,50,220,5,0,0.005,25,0,0,0,0,1);
    close_to(MeasureResult.V_in_rms,baseline.V_in_rms*1.1f,0.001f,"persisted Vin gain");
    close_to(MeasureResult.V_out_rms,baseline.V_out_rms*0.9f,0.001f,"persisted Vout gain");
    close_to(MeasureResult.I_in_rms,baseline.I_in_rms*1.2f,0.0001f,"persisted current gain");
    close_to(MeasureResult.I_leak_rms,baseline.I_leak_rms*1.5f,0.000001f,"persisted leakage gain");
    close_to(MeasureResult.I_leak_peak_max,baseline.I_leak_peak_max*1.5f,0.000001f,"persisted gain applies to peak maximum");
    close_to(MeasureResult.I_leak_rms_max,baseline.I_leak_rms_max*1.5f,0.000001f,"persisted gain applies to RMS maximum");
    close_to(MeasureResult.P_in_active,baseline.P_in_active*1.1f*1.2f,0.001f,"power uses both calib_params gains");
    close_to(MeasureResult.S_in_apparent,baseline.S_in_apparent*1.1f*1.2f,0.001f,"apparent power uses calib_params RMS");
    close_to(MeasureResult.PowerFactor_in,baseline.PowerFactor_in,0.00001f,"gain calib preserves power factor");
    close_to(MeasureResult.Temperature,baseline.Temperature+2.5f,0.0001f,"persisted temperature offset");
    check(leak_trip_counts==5,"leakage gain updates peak ADC threshold");
    /* Isolate configured threshold arithmetic from continuous tracking;
     * fractional estimation and tracking are exercised separately. */
    leakage_offset_q19=adc_offset[ADC_CH_ILEAK]*LEAK_OFFSET_SCALE;
    leakage_offset_hold=1;
    MeasureResult.leakage_trip_flag=0;
    ProcessFastLeakage((adc_offset[ADC_CH_ILEAK]+4)*SIGNAL_SCALE,(uint16_t)(adc_offset[ADC_CH_ILEAK]+4));
    check(!MeasureResult.leakage_trip_flag,"calib_params peak stays clear below threshold");
    for(unsigned n=0;n<MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES;n++)
        ProcessFastLeakage((adc_offset[ADC_CH_ILEAK]+5)*SIGNAL_SCALE,(uint16_t)(adc_offset[ADC_CH_ILEAK]+5));
    check(MeasureResult.leakage_trip_flag,"calib_params peak trips at threshold");
    ProtectionParams_t protection = PROTECTION_DEFAULT_PARAMS;
    protection.leak_fast_peak_a = 0.060f;
    check(Calib_SaveProtection(&protection)==CALIB_OK,"save independent fast peak threshold");
    check(leak_trip_counts==5,"saved fast threshold waits for reboot");
    reset_measurement();
    check(leak_trip_counts==10,"fast threshold uses config and retained leakage gain");
    MeasureResult.fast_leakage_ready=1;
    leakage_offset_q19=adc_offset[ADC_CH_ILEAK]*LEAK_OFFSET_SCALE;
    leakage_offset_hold=1;
    ProcessFastLeakage((adc_offset[ADC_CH_ILEAK]+9)*SIGNAL_SCALE,(uint16_t)(adc_offset[ADC_CH_ILEAK]+9));
    check(!MeasureResult.leakage_trip_flag,"configured peak clear below threshold");
    for(unsigned n=0;n<MEASUREMENT_LEAK_FAST_CONFIRM_SAMPLES;n++)
        ProcessFastLeakage((adc_offset[ADC_CH_ILEAK]+10)*SIGNAL_SCALE,(uint16_t)(adc_offset[ADC_CH_ILEAK]+10));
    check(MeasureResult.leakage_trip_flag,"configured peak trips at ADC boundary");
    FakeFlash_Reset(); reset_measurement();

    mock_te=1; Measurement_DMA_IRQHandler();
    check(mock_errors==1 && !mock_dma_running && !mock_timer_running,"DMA error stops acquisition and invokes handler");

    printf("%u checks, %u failures\n",checks,failures);
    return failures?1:0;
}
