#include "Protection.h"
#include "Rte.h"
#include "flash_fake.h"
#include <assert.h>
#include <math.h>
#include <stdio.h>
#include <string.h>

unsigned mock_pins[4], mock_primask, mock_systick_enabled;
unsigned mock_trip_on_unmask;
static unsigned checks;
#if PROTECTION_MODE == PROTECTION_MODE_DEBUG
extern volatile MeasureResult_t MeasureResult_test;
#define TestInput MeasureResult_test
#else
#define TestInput MeasureResult
#endif
/* Measurement/application peers of the real RTE, unused by these unit cases. */
void MeasurementInit(void) {}
void Measurement_MainFunction(void) {}
void Measurement_DMA_IRQHandler(void) {}
void Error_Handler(void) {}
#define CHECK(expr) do { ++checks; assert(expr); } while (0)

void mock_restore_primask(uint32_t value)
{
    mock_primask = value;
    if (value == 0U && mock_trip_on_unmask != 0U)
    {
        mock_trip_on_unmask = 0U;
        TestInput.leakage_trip_flag = 1U;
        Protection_FastLeakageISR();
    }
}

static void healthy(void)
{
    memset((void *)&TestInput, 0, sizeof(TestInput));
    TestInput.V_in_rms = 220.0f;
    TestInput.V_out_rms = 220.0f;
    TestInput.I_in_rms = 1.0f;
    TestInput.I_leak_rms = 0.005f;
    TestInput.Temperature = 25.0f;
    TestInput.startup_complete = 1U;
    TestInput.fast_leakage_ready = 1U;
}

static void boot(void)
{
    healthy();
    mock_primask = mock_trip_on_unmask = mock_systick_enabled = 0U;
    ProtectionInit();
}

static void relays_off(void)
{
    CHECK(mock_pins[0] == 0U && mock_pins[1] == 0U);
}

static void complete_trip(void)
{
    if (Protection_IsTripPending())
    {
        CHECK(mock_pins[0] == 1U && mock_pins[1] == 1U);
        Protection_ZeroCrossISR();
    }
    CHECK(Protection_IsTripPending() == 0U);
    relays_off();
}

static void threshold_test(volatile float *value, float threshold, uint32_t fault)
{
    boot();
    *value = nextafterf(threshold, -INFINITY);
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask() == 0U);
    CHECK(mock_pins[0] == 1U && mock_pins[1] == 1U);
    CHECK(mock_pins[2] == 1U && mock_pins[3] == 0U);
    *value = threshold;
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask() == fault);
    CHECK(Protection_IsTripPending() == 1U);
    CHECK(mock_pins[2] == 1U && mock_pins[3] == 1U);
    complete_trip();
    healthy();
    Protection_MainFunction();
    relays_off();
    CHECK(Protection_GetFaultMask() == fault);
    boot();
    *value = nextafterf(threshold, INFINITY);
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask() == fault);
    complete_trip();
}

int main(void)
{
    boot();
    TestInput.fast_leakage_ready=0U;
    Protection_MainFunction();
    relays_off();
    CHECK(Protection_GetFaultMask()==0U);
    for(unsigned i=0;i<1000U;i++) Protection_Tick1msISR();
    Protection_MainFunction();
    relays_off();
    TestInput.fast_leakage_ready=1U;
    Protection_MainFunction();
    CHECK(mock_pins[0] && mock_pins[1]);
    boot();
    TestInput.fast_leakage_ready=0U;
    TestInput.I_leak_rms=0.040f;
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_LEAK);
    relays_off();

    boot();
    TestInput.V_in_rms=250;
    Protection_MainFunction();
    healthy();
    TestInput.fast_leakage_ready=0U;
    Protection_MainFunction();
    for(unsigned i=0;i<1000U;i++) Protection_Tick1msISR();
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_OV_IN);
    relays_off();
    TestInput.fast_leakage_ready=1U;
    Protection_MainFunction();
    for(unsigned i=0;i<1000U;i++) Protection_Tick1msISR();
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0 && mock_pins[0] && mock_pins[1]);

    boot();
    TestInput.startup_complete = 0U;
    Protection_MainFunction();
    relays_off();
    CHECK(mock_pins[2] == 1U && mock_pins[3] == 0U && mock_systick_enabled == 0U);
    CHECK(Protection_GetFaultMask() == 0U);
    for (unsigned i = 0; i < 1000U; ++i) Protection_Tick1msISR();
    CHECK(mock_pins[2] == 1U && mock_pins[3] == 0U);
    healthy();
    Protection_MainFunction();
    CHECK(mock_pins[0] == 1U && mock_pins[1] == 1U && mock_pins[2] == 1U);
    CHECK(mock_pins[3] == 0U);

    threshold_test(&TestInput.V_in_rms, 240.0f, PROTECTION_FAULT_OV_IN);
    threshold_test(&TestInput.V_out_rms, 240.0f, PROTECTION_FAULT_OV_OUT);
    threshold_test(&TestInput.I_in_rms, 2.8f, PROTECTION_FAULT_OC);
    threshold_test(&TestInput.I_leak_rms, 0.030f, PROTECTION_FAULT_LEAK);
    threshold_test(&TestInput.Temperature, 70.0f, PROTECTION_FAULT_OT);

    boot();
    TestInput.V_in_rms = TestInput.V_out_rms = 300.0f;
    TestInput.I_in_rms = 4.0f;
    TestInput.I_leak_rms = 0.040f;
    TestInput.Temperature = 80.0f;
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask() == (PROTECTION_FAULT_OV_IN |
        PROTECTION_FAULT_OV_OUT | PROTECTION_FAULT_OC | PROTECTION_FAULT_LEAK |
        PROTECTION_FAULT_OT));
    relays_off();
    CHECK(mock_pins[2] == 1U && mock_pins[3] == 1U);
    for (unsigned ms = 1; ms <= 2000U; ++ms)
    {
        Protection_Tick1msISR();
        Protection_MainFunction(); /* Repeated faults must not restart blink. */
        CHECK(mock_pins[2] == ((ms / 250U) % 2U == 0U));
        CHECK(mock_pins[3] == mock_pins[2]);
    }

    boot();
    Protection_MainFunction();
    TestInput.leakage_trip_flag = 1U;
    Protection_FastLeakageISR(); /* Requests a trip; waits for the next crossing. */
    CHECK(Protection_IsTripPending() == 1U);
    complete_trip();
    CHECK(Protection_GetFaultMask() == PROTECTION_FAULT_LEAK);
    for (unsigned ms = 1; ms <= 500U; ++ms)
    {
        Protection_FastLeakageISR();
        Protection_Tick1msISR();
        CHECK(mock_pins[2] == ((ms / 250U) % 2U == 0U));
        CHECK(mock_pins[3] == mock_pins[2]);
    }
    healthy(); /* Even clearing the measurement flag cannot reset protection. */
    Protection_MainFunction();
    relays_off();
    for (unsigned ms=1U; ms<=500U; ++ms)
    {
        Protection_Tick1msISR();
        Protection_MainFunction();
        CHECK(mock_pins[2] == ((ms / 250U) % 2U == 0U));
        CHECK(mock_pins[3] == mock_pins[2]); /* Latched fault keeps sound cycling. */
    }
    boot(); /* MCU restart clears sound even after a latched audible fault. */
    CHECK(mock_pins[2] == 1U && mock_pins[3] == 0U);

    boot();
    TestInput.startup_complete = 0U;
    TestInput.leakage_trip_flag = 1U;
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask() == PROTECTION_FAULT_LEAK);
    relays_off();

    volatile float *fields[] = { &TestInput.V_in_rms, &TestInput.V_out_rms,
        &TestInput.I_in_rms, &TestInput.I_leak_rms, &TestInput.Temperature };
    for (unsigned i = 0; i < 5U; ++i)
    {
        const float invalid[] = { NAN, INFINITY, -INFINITY };
        for (unsigned j = 0; j < 3U; ++j)
        {
            boot();
            *fields[i] = invalid[j];
            Protection_MainFunction();
            CHECK((Protection_GetFaultMask() & PROTECTION_FAULT_MEASUREMENT) != 0U);
            relays_off();
        }
        if (i < 4U)
        {
            boot();
            *fields[i] = -0.001f;
            Protection_MainFunction();
            CHECK(Protection_GetFaultMask() == PROTECTION_FAULT_MEASUREMENT);
            relays_off();
        }
    }
    boot();
    TestInput.Temperature = -20.0f;
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask() == 0U); /* Valid sub-zero temperature. */
    boot();
    TestInput.temperature_fault = 1U;
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask() == PROTECTION_FAULT_MEASUREMENT);
    relays_off();
    for (unsigned ch = 0; ch < 5U; ++ch)
    {
        boot();
        TestInput.adc_clipped_mask = (AdcClippedMask_t)(1U << ch);
        Protection_MainFunction();
        CHECK(Protection_GetFaultMask() == PROTECTION_FAULT_MEASUREMENT);
        relays_off();
    }

    boot();
    mock_primask = 1U;
    Protection_MainFunction();
    CHECK(mock_primask == 1U); /* Preserve caller's interrupt mask. */
    boot();
    mock_trip_on_unmask = 1U;
    Protection_MainFunction(); /* DMA pending while closing relays. */
    CHECK(Protection_IsTripPending() == 1U);
    complete_trip();
    CHECK(Protection_GetFaultMask() == PROTECTION_FAULT_LEAK);
    healthy();
    Protection_MainFunction();
    relays_off();

    /* A previous crossing must not be reused for a later fault. */
    boot();
    Protection_MainFunction();
    Protection_ZeroCrossISR();
    CHECK(mock_pins[0] == 1U && mock_pins[1] == 1U);
    TestInput.Temperature = 70.0f;
    Protection_MainFunction();
    CHECK(Protection_IsTripPending() == 1U);
    for (unsigned ms = 1; ms < 30U; ++ms)
    {
        Protection_Tick1msISR();
        Protection_MainFunction(); /* Must not restart the timeout. */
        CHECK(Protection_IsTripPending() == 1U);
        CHECK(mock_pins[0] == 1U && mock_pins[1] == 1U);
    }
    Protection_Tick1msISR();
    CHECK(Protection_IsTripPending() == 0U);
    relays_off();
    healthy();
    Protection_MainFunction();
    Protection_ZeroCrossISR();
    relays_off();

    /* Crossing beats timeout at 29 ms. A cleared sensor cannot cancel a trip. */
    boot();
    Protection_MainFunction();
    TestInput.I_in_rms = 2.8f;
    Protection_MainFunction();
    healthy();
    for (unsigned ms = 0; ms < 29U; ++ms) Protection_Tick1msISR();
    Protection_MainFunction();
    CHECK(Protection_IsTripPending() == 1U);
    complete_trip();
    Protection_Tick1msISR();
    relays_off();

    /* Leakage appearing before a crossing in one DMA batch uses that crossing,
     * even before the end-of-DMA fast-leakage hook has run. */
    boot();
    Protection_MainFunction();
    TestInput.leakage_trip_flag = 1U;
    Protection_ZeroCrossISR();
    CHECK(Protection_GetFaultMask() == PROTECTION_FAULT_LEAK);
    CHECK(Protection_IsTripPending() == 0U);
    relays_off();
    boot();
    Protection_MainFunction();
    TestInput.Temperature=70.0f;
    Protection_MainFunction();
    mock_primask=1U;
    Protection_EmergencyStop();
    CHECK(mock_primask==1U);
    CHECK(Protection_IsTripPending()==0U);
    CHECK((Protection_GetFaultMask() & PROTECTION_FAULT_MEASUREMENT)!=0U);
    relays_off();
    for (unsigned ms=1U; ms<=500U; ++ms)
    {
        Rte_Call_Protection_Tick1msISR(); /* Error_Handler polled-tick path. */
        CHECK(mock_primask==1U);
        CHECK(mock_pins[2] == ((ms / 250U) % 2U == 0U));
        CHECK(mock_pins[3] == mock_pins[2]);
    }

    /* DEBUG must isolate both main checks and the fast ISR from real data. */
#if PROTECTION_MODE == PROTECTION_MODE_DEBUG
    boot();
    MeasureResult.leakage_trip_flag=1U;
    MeasureResult.I_in_rms=100.0f;
    Protection_MainFunction();
    Protection_FastLeakageISR();
    CHECK(Protection_GetFaultMask()==0U);
    CHECK(mock_pins[0] && mock_pins[1]);
    memset(&MeasureResult,0,sizeof(MeasureResult));
#else
    /* RELEASE (the default) must respond to the real fast leakage flag. */
    boot(); Protection_MainFunction();
    MeasureResult.leakage_trip_flag=1U; Protection_FastLeakageISR();
    CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_LEAK); complete_trip();
#endif

    volatile float *recover_fields[]={&TestInput.V_in_rms,
        &TestInput.V_out_rms,&TestInput.Temperature};
    const float trip_limits[]={PROTECTION_OV_V,PROTECTION_OV_V,PROTECTION_OT_C};
    const float recover_limits[]={PROTECTION_OV_RECOVER_V,PROTECTION_OV_RECOVER_V,
        PROTECTION_OT_RECOVER_C};
    const uint32_t recover_faults[]={PROTECTION_FAULT_OV_IN,PROTECTION_FAULT_OV_OUT,
        PROTECTION_FAULT_OT};
    for(unsigned f=0;f<3U;f++)
    {
        boot(); Protection_MainFunction();
        *recover_fields[f]=trip_limits[f]; Protection_MainFunction();
        CHECK(Protection_GetFaultMask()==recover_faults[f]);
        complete_trip();
        /* Below trip but still inside hysteresis: never reclose. */
        healthy();
        *recover_fields[f]=nextafterf(recover_limits[f],INFINITY);
        for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS+100U;ms++)
        { Protection_MainFunction(); Protection_Tick1msISR(); }
        relays_off();
        CHECK(Protection_GetFaultMask()==recover_faults[f]);
        /* Equality at the recovery limit is allowed. Main calls are not ticks. */
        *recover_fields[f]=recover_limits[f]; Protection_MainFunction();
        for(unsigned n=0;n<10000U;n++) Protection_MainFunction();
        relays_off();
        for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS-1U;ms++)
        { Protection_Tick1msISR(); Protection_MainFunction(); }
        CHECK(Protection_GetFaultMask()==recover_faults[f]); relays_off();
        CHECK(mock_pins[2]==mock_pins[3]);
        Protection_Tick1msISR(); Protection_MainFunction();
        CHECK(Protection_GetFaultMask()==0U && !Protection_IsTripPending());
        CHECK(mock_pins[0] && mock_pins[1]);
        CHECK(mock_pins[2] && !mock_pins[3]);
        /* A later fault can start the alarm and trip sequence again. */
        *recover_fields[f]=trip_limits[f]; Protection_MainFunction();
        CHECK(Protection_GetFaultMask()==recover_faults[f]);
        CHECK(Protection_IsTripPending() && mock_pins[2] && mock_pins[3]);
        complete_trip();
    }

    /* All recoverable faults clear together; every voltage and temperature
     * must pass, even if a different channel caused the original trip. */
    boot(); Protection_MainFunction();
    TestInput.V_in_rms=300; TestInput.V_out_rms=300;
    TestInput.Temperature=80; Protection_MainFunction(); complete_trip();
    TestInput.V_in_rms=180; Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==PROTECTION_RECOVERABLE_FAULTS);
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<500U;ms++) { Protection_Tick1msISR(); Protection_MainFunction(); }
    TestInput.V_out_rms=235; Protection_MainFunction();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS-1U;ms++)
    { Protection_Tick1msISR(); Protection_MainFunction(); }
    CHECK(Protection_GetFaultMask()==PROTECTION_RECOVERABLE_FAULTS); relays_off();
    Protection_Tick1msISR(); Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0U && mock_pins[0] && mock_pins[1]);

    /* Returning to normal cannot cancel a pending relay-open command, and the
     * hold starts only after the relay has actually received its OFF command. */
    boot(); Protection_MainFunction();
    TestInput.Temperature=70; Protection_MainFunction();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_ZERO_CROSS_TIMEOUT_MS-1U;ms++)
    { Protection_Tick1msISR(); Protection_MainFunction(); }
    CHECK(Protection_IsTripPending() && mock_pins[0] && mock_pins[1]);
    Protection_Tick1msISR(); Protection_MainFunction(); relays_off();
    for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS-1U;ms++)
    { Protection_Tick1msISR(); Protection_MainFunction(); }
    relays_off(); Protection_Tick1msISR(); Protection_MainFunction();
    CHECK(mock_pins[0] && mock_pins[1] && Protection_GetFaultMask()==0U);

    /* Missing startup-valid cancels the hold and cannot clear a trip. */
    boot(); TestInput.V_in_rms=300; Protection_MainFunction();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<500U;ms++) Protection_Tick1msISR();
    TestInput.startup_complete=0; Protection_MainFunction();
    for(unsigned ms=0;ms<2000U;ms++) { Protection_Tick1msISR(); Protection_MainFunction(); }
    CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_OV_IN); relays_off();
    healthy(); Protection_MainFunction();
    /* Saturating ISR timer: long main stalls cannot wrap or close in the ISR. */
    for(unsigned ms=0;ms<70000U;ms++) Protection_Tick1msISR();
    relays_off(); CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_OV_IN);
    Protection_MainFunction(); CHECK(Protection_GetFaultMask()==0U && mock_pins[0]);

    /* A new over-threshold excursion restarts the full hold. */
    boot(); TestInput.V_in_rms=300; Protection_MainFunction();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<900U;ms++) Protection_Tick1msISR();
    TestInput.Temperature=70; Protection_MainFunction();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS-1U;ms++)
    { Protection_Tick1msISR(); Protection_MainFunction(); }
    relays_off(); Protection_Tick1msISR(); Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0U && mock_pins[0]);

    /* OC, RMS leakage, measurement fault and fast leakage permanently inhibit
     * recovery, both alone and combined with a recoverable fault. */
    const uint32_t permanent[]={PROTECTION_FAULT_OC,PROTECTION_FAULT_LEAK,
        PROTECTION_FAULT_MEASUREMENT,PROTECTION_FAULT_LEAK};
    for(unsigned mixed=0;mixed<2U;mixed++) for(unsigned kind=0;kind<4U;kind++)
    {
        boot(); Protection_MainFunction();
        if(mixed) { TestInput.V_in_rms=300; Protection_MainFunction(); complete_trip(); healthy(); Protection_MainFunction(); }
        if(kind==0) TestInput.I_in_rms=PROTECTION_OC_A;
        if(kind==1) TestInput.I_leak_rms=PROTECTION_LEAK_A;
        if(kind==2) TestInput.temperature_fault=1;
        if(kind==3) { TestInput.leakage_trip_flag=1; Protection_FastLeakageISR(); }
        Protection_MainFunction(); complete_trip(); healthy();
        for(unsigned ms=0;ms<5000U;ms++) { Protection_Tick1msISR(); Protection_MainFunction(); }
        CHECK(Protection_GetFaultMask()==(permanent[kind]|(mixed?PROTECTION_FAULT_OV_IN:0U)));
        relays_off(); CHECK(mock_pins[2]==mock_pins[3]);
    }

    /* Fast ISR trip arriving after the hold matures wins over recovery. */
    boot(); Protection_MainFunction();
    TestInput.V_in_rms=300; Protection_MainFunction(); complete_trip();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS;ms++) Protection_Tick1msISR();
    TestInput.leakage_trip_flag=1; Protection_FastLeakageISR();
    healthy(); Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==(PROTECTION_FAULT_OV_IN|PROTECTION_FAULT_LEAK)); relays_off();

    /* DMA pending at recovery's unmask requests a fresh trip, never erases it. */
    boot(); Protection_MainFunction();
    TestInput.V_in_rms=300; Protection_MainFunction(); complete_trip();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS;ms++) Protection_Tick1msISR();
    mock_trip_on_unmask=1; Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_LEAK && Protection_IsTripPending());
    complete_trip();

    /* Vin undervoltage: just above 190 V is allowed, equality and below trip.
     * Keep the independent numeric boundary to verify the requested setting. */
    const float uv_values[]={nextafterf(190.0f,INFINITY),190.0f,
        nextafterf(190.0f,-INFINITY),0.0f};
    for(unsigned n=0;n<4U;n++)
    {
        boot(); Protection_MainFunction();
        TestInput.V_in_rms=uv_values[n]; Protection_MainFunction();
        if(n==0U)
        {
            CHECK(Protection_GetFaultMask()==0U && mock_pins[0] && mock_pins[1]);
        }
        else
        {
            CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_UV_IN);
            CHECK(Protection_IsTripPending() && mock_pins[2] && mock_pins[3]);
            complete_trip();
        }
    }
    /* Never classify startup's zero-filled input as a valid UV measurement. */
    boot(); TestInput.V_in_rms=0; TestInput.startup_complete=0;
    Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0U); relays_off();
    TestInput.startup_complete=1; Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_UV_IN); relays_off();

    /* UV is Vin-only: a disconnected output at 0 V must not block reclosure. */
    boot(); TestInput.V_out_rms=0; Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0U && mock_pins[0] && mock_pins[1]);
    TestInput.V_in_rms=190; Protection_MainFunction(); complete_trip();
    TestInput.V_in_rms=nextafterf(200.0f,-INFINITY);
    for(unsigned ms=0;ms<2000U;ms++) { Protection_Tick1msISR(); Protection_MainFunction(); }
    CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_UV_IN); relays_off();
    TestInput.V_in_rms=200.0f; Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS-1U;ms++)
    { Protection_Tick1msISR(); Protection_MainFunction(); }
    relays_off(); CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_UV_IN);
    Protection_Tick1msISR(); Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0U && mock_pins[0] && mock_pins[1]);
    CHECK(mock_pins[2] && !mock_pins[3]);

    /* A dip into 190..200 V cancels recovery, even after an OV/OT trip. */
    boot(); TestInput.V_in_rms=300; Protection_MainFunction();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<900U;ms++) Protection_Tick1msISR();
    TestInput.V_in_rms=195; Protection_MainFunction();
    healthy(); Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_RECOVER_HOLD_MS-1U;ms++)
    { Protection_Tick1msISR(); Protection_MainFunction(); }
    relays_off(); Protection_Tick1msISR(); Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0U && mock_pins[0]);

    /* Missing zero crossings at a complete loss of Vin use the existing 30 ms
     * relay-open timeout, then wait for full voltage recovery. */
    boot(); Protection_MainFunction();
    TestInput.V_in_rms=0; Protection_MainFunction();
    for(unsigned ms=0;ms<PROTECTION_ZERO_CROSS_TIMEOUT_MS-1U;ms++)
    { Protection_Tick1msISR(); Protection_MainFunction(); }
    CHECK(Protection_IsTripPending() && mock_pins[0]);
    Protection_Tick1msISR(); CHECK(!Protection_IsTripPending()); relays_off();

    /* UV does not permit clearing an OC/LEAK/MEASUREMENT fault. */
    for(unsigned kind=0;kind<3U;kind++)
    {
        boot(); TestInput.V_in_rms=180;
        if(kind==0U) TestInput.I_in_rms=PROTECTION_OC_A;
        if(kind==1U) TestInput.I_leak_rms=PROTECTION_LEAK_A;
        if(kind==2U) TestInput.temperature_fault=1;
        Protection_MainFunction(); healthy();
        for(unsigned ms=0;ms<2000U;ms++) { Protection_Tick1msISR(); Protection_MainFunction(); }
        CHECK(Protection_GetFaultMask()==(PROTECTION_FAULT_UV_IN|permanent[kind]));
        relays_off();
    }

    /* Flash service opens immediately and cannot auto-recover/reclose. */
    boot(); Protection_MainFunction();
    CHECK(mock_pins[0] && mock_pins[1]);
    Protection_EnterCalibMode(); relays_off();
    CHECK(Protection_GetFaultMask() == 0U && !Protection_IsTripPending());
    for (unsigned ms = 0; ms < 2000; ms++)
    { Protection_Tick1msISR(); Protection_ZeroCrossISR(); Protection_MainFunction(); }
    relays_off();
    /* Enter during a pending recoverable trip and a DMA ISR race. */
    boot(); Protection_MainFunction();
    TestInput.V_in_rms = 300; Protection_MainFunction();
    CHECK(Protection_IsTripPending());
    mock_trip_on_unmask = 1;
    Protection_EnterCalibMode();
    relays_off(); CHECK(!Protection_IsTripPending());
    healthy();
    for (unsigned ms = 0; ms < 2000; ms++)
    { Protection_Tick1msISR(); Protection_ZeroCrossISR(); Protection_MainFunction(); }
    relays_off();
    boot(); Protection_MainFunction(); CHECK(mock_pins[0] && mock_pins[1]);

    /* Configured trip/recovery boundaries in both real/debug input modes. */
    FakeFlash_Reset(); Calib_Init();
    ProtectionParams_t cfg = PROTECTION_DEFAULT_PARAMS;
    cfg.ov_v=250; cfg.uv_in_v=180; cfg.oc_a=2; cfg.leak_a=0.02f;
    cfg.ot_c=60; cfg.ov_recover_v=225; cfg.uv_in_recover_v=205;
    cfg.ot_recover_c=50; cfg.recover_hold_ms=7;
    CHECK(Calib_SaveProtection(&cfg)==CALIB_OK);
    CHECK(Calib_GetProtection()->oc_a==PROTECTION_OC_A); /* no live apply */
    Calib_Init();
    threshold_test(&TestInput.V_in_rms,cfg.ov_v,PROTECTION_FAULT_OV_IN);
    threshold_test(&TestInput.V_out_rms,cfg.ov_v,PROTECTION_FAULT_OV_OUT);
    threshold_test(&TestInput.I_in_rms,cfg.oc_a,PROTECTION_FAULT_OC);
    threshold_test(&TestInput.I_leak_rms,cfg.leak_a,PROTECTION_FAULT_LEAK);
    threshold_test(&TestInput.Temperature,cfg.ot_c,PROTECTION_FAULT_OT);
    boot(); TestInput.V_in_rms=cfg.uv_in_v;
    Protection_MainFunction(); CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_UV_IN);
    healthy(); TestInput.V_in_rms=nextafterf(cfg.uv_in_recover_v,-INFINITY);
    for(unsigned i=0;i<10;i++) { Protection_MainFunction(); Protection_Tick1msISR(); }
    relays_off(); CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_UV_IN);
    TestInput.V_in_rms=cfg.uv_in_recover_v;
    TestInput.V_out_rms=cfg.ov_recover_v;
    TestInput.Temperature=cfg.ot_recover_c;
    Protection_MainFunction();
    for(unsigned i=0;i<cfg.recover_hold_ms-1;i++) Protection_Tick1msISR();
    Protection_MainFunction(); relays_off();
    Protection_Tick1msISR(); Protection_MainFunction();
    CHECK(Protection_GetFaultMask()==0 && mock_pins[0] && mock_pins[1]);
    /* New recovery limits still cancel the hold until all three pass. */
    for(unsigned field=0;field<3;field++)
    {
        boot(); TestInput.V_in_rms=260; Protection_MainFunction(); healthy();
        if(field==0) TestInput.V_in_rms=nextafterf(cfg.ov_recover_v,INFINITY);
        if(field==1) TestInput.V_out_rms=nextafterf(cfg.ov_recover_v,INFINITY);
        if(field==2) TestInput.Temperature=nextafterf(cfg.ot_recover_c,INFINITY);
        for(unsigned i=0;i<10;i++) { Protection_MainFunction(); Protection_Tick1msISR(); }
        relays_off(); CHECK(Protection_GetFaultMask()==PROTECTION_FAULT_OV_IN);
    }
    FakeFlash_Reset(); Calib_Init();
    printf("Protection: %u checks passed\n", checks);
    return 0;
}
