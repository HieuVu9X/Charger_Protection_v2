#ifndef SCHEDULER_TEST_MAIN_H
#define SCHEDULER_TEST_MAIN_H
#include <stdint.h>
#define __WEAK __attribute__((weak))
extern uint32_t mock_primask;
void mock_restore_primask(uint32_t value);
void LL_SYSTICK_EnableIT(void);
void Error_Handler(void);
static inline uint32_t __get_PRIMASK(void) { return mock_primask; }
static inline void __disable_irq(void) { mock_primask = 1U; }
static inline void __set_PRIMASK(uint32_t value) { mock_restore_primask(value); }
#endif
